# fail2ban jails for the AICC edge  ->  /etc/fail2ban/jail.d/aicc-edge.local   (the sshd jail is already enabled by cloud-init in jail.d/aicc-sshd.local)
# Both jails read the Caddy access log. The log file is created (empty, aicc-edge:adm 0640) by install-stack.sh so the jails can start before Caddy does.
# 127.0.0.1/8 and ::1 are NEVER banned: the operator reaches wp-admin through an SSH tunnel and appears as 127.0.0.1.
# Ban action: the distro default (iptables/nft multiport through the system action); UFW keeps its own rules, fail2ban adds a separate chain.
# Increment: repeat offenders are banned for longer (bantime.increment), capped at one week.
#
# ignoreip: loopback only, as shipped. This file is REPLACED by infra/provision/install-stack.sh on every install, so do not edit it. To exempt more addresses (the host's own
# address that Action Scheduler loopbacks arrive from, an office, a monitoring probe) create the OPTIONAL operator-owned file /etc/fail2ban/jail.d/zz-aicc-local.local (absent by
# default; "zz" makes it load after this one; the installer never creates, overwrites or removes it) with one section per jail you want to change, for example
#     [aicc-wp-login]
#     ignoreip = 127.0.0.1/8 ::1 10.19.0.2
#     [caddy-4xx-flood]
#     ignoreip = 127.0.0.1/8 ::1 10.19.0.2
# then `sudo fail2ban-client -t && sudo systemctl reload fail2ban`. A value there REPLACES the list above, so repeat the loopback entries. Details and limits of the jail:
# filter.d-aicc-wp-login.conf (it counts every POST to /my-account/ and /wp-login.php, successful or not) and docs/cutover/runbook.md.

[aicc-wp-login]
enabled   = true
filter    = aicc-wp-login
logpath   = /var/log/aicc-edge/aicc-edge.log
backend   = auto
port      = http,https
protocol  = tcp
ignoreip  = 127.0.0.1/8 ::1
# 10 hits in 10 minutes -> 1 hour. A customer needs at most a few POSTs (sign-in, mistakes, lost-password); a guessing bot exceeds this in seconds.
maxretry  = 10
findtime  = 10m
bantime   = 1h
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

[caddy-4xx-flood]
enabled   = true
filter    = caddy-4xx-flood
logpath   = /var/log/aicc-edge/aicc-edge.log
backend   = auto
port      = http,https
protocol  = tcp
ignoreip  = 127.0.0.1/8 ::1
# 100 scanner-class errors (400/401/403/404/405, minus static assets and browser-labelled cross-site requests, see the filter) in 60 seconds from one address -> 30 minutes.
# F-09: it only stops obvious scanners; it cannot be turned against a visitor by an <img> flood on another site. The sentinel only sees 200s and is never counted.
maxretry  = 100
findtime  = 60s
bantime   = 30m
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1d
