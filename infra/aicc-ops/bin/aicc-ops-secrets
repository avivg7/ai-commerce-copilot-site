#!/usr/bin/env bash
# aicc-ops-secrets: host-side helper to set / inspect / remove the Telegram credentials of AICC Ops WITHOUT the secret ever being
# typed into a shell argument, an environment variable, a chat, a ticket or the repo. Installed to /usr/local/sbin (root:root 0750).
#
#   sudo aicc-ops-secrets set-telegram [--keep-token] [--chat-id <id>] [--stdin]
#   aicc-ops-secrets status
#   sudo aicc-ops-secrets remove-telegram [--yes]
#
# set-telegram reads the bot token with `read -rs` (no echo) from the terminal; with --stdin it reads ONE line (the token) from stdin
# instead (for a password manager pipe: `pm get aicc-bot | sudo aicc-ops-secrets set-telegram --stdin --chat-id 123456789`). The token is never
# taken from argv or the environment. The chat id is not secret and may be typed (echoed) or given with --chat-id. --keep-token reuses the
# token already in the file and only updates the chat id (use it after `aicc-ops telegram-discover-chat`).
# The file /etc/aicc-ops/secrets.env is replaced ATOMICALLY (same-directory temp file, umask 077, chmod 0640, chown root:aicc-ops, mv),
# other keys already in it are preserved. Nothing is restarted: the script prints the exact command.
# Exit codes: 0 ok, 1 failed (including a failed telegram-check), 2 usage / invalid input, 3 refused (not root, no TTY, ...).
set +x
unset BASH_XTRACEFD
set -euo pipefail
umask 077
unset HISTFILE
set +o history

HARNESS=0
[ "${AICC_OPS_TEST_HARNESS:-}" = "1" ] && HARNESS=1

# Test seams are honoured ONLY under AICC_OPS_TEST_HARNESS=1; a real run ignores these variables completely.
ETC="/etc/aicc-ops"
CLI="/opt/aicc-ops/bin/aicc-ops"
SVC_GROUP="aicc-ops"
if [ "$HARNESS" = 1 ]; then
  ETC="${AICC_OPS_ETC:-$ETC}"
  CLI="${AICC_OPS_CLI:-$CLI}"
else
  PATH="/usr/sbin:/usr/bin:/sbin:/bin"
  export PATH
fi
SECRETS="$ETC/secrets.env"
TMP=""
TTY_STATE=""

say() { printf '%s\n' "$*"; }
err() { printf 'aicc-ops-secrets: %s\n' "$*" >&2; }
die() { err "$2"; exit "$1"; }
cleanup() {
  [ -n "$TMP" ] && rm -f -- "$TMP"
  [ -n "$TTY_STATE" ] && stty "$TTY_STATE" 2>/dev/null
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

usage() { sed -n '2,15p' "$0"; }

require_root() {
  if [ "$(id -u)" -ne 0 ] && [ "$HARNESS" != 1 ]; then die 3 "must run as root (sudo aicc-ops-secrets $1)"; fi
}

KEY_RE='^[[:space:]]*(export[[:space:]]+)?TELEGRAM_(BOT_TOKEN|CHAT_ID)[[:space:]]*='

# Print the existing value of TELEGRAM_<name> (BOT_TOKEN|CHAT_ID) from the secrets file, quotes stripped. Prints nothing if absent.
existing_value() {
  local name="$1" line v
  [ -r "$SECRETS" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?TELEGRAM_${name}[[:space:]]*=(.*)$ ]]; then
      v="${BASH_REMATCH[2]}"
      v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
      v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
      printf '%s' "$v"
    fi
  done < "$SECRETS"
}

# Write the secrets file atomically. Args: token chat_id (either may be empty = omit). Other keys/comments are preserved verbatim.
write_secrets() {
  local token="$1" chat="$2" line
  [ -d "$ETC" ] || die 1 "$ETC does not exist (is AICC Ops installed?)"
  if [ "$HARNESS" != 1 ] || [ "$(id -u)" -eq 0 ]; then
    getent group "$SVC_GROUP" >/dev/null 2>&1 || die 1 "group $SVC_GROUP does not exist (is AICC Ops installed?)"
  fi
  TMP="$(mktemp "$ETC/.secrets.env.XXXXXX")"
  {
    if [ -r "$SECRETS" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ $KEY_RE ]] && continue
        printf '%s\n' "$line"
      done < "$SECRETS"
    fi
    [ -n "$token" ] && printf 'TELEGRAM_BOT_TOKEN=%s\n' "$token"
    [ -n "$chat" ] && printf 'TELEGRAM_CHAT_ID=%s\n' "$chat"
    true
  } > "$TMP"
  chmod 0640 "$TMP"
  if [ "$(id -u)" -eq 0 ]; then chown "root:$SVC_GROUP" "$TMP"; fi
  mv -f -- "$TMP" "$SECRETS"
  TMP=""
}

# telegram-check through the installed CLI: no secret on argv, no secret in the environment (the CLI reads the file itself).
# Run as the service user when possible, which also proves the daemon can read the file.
run_check() {
  local cfg=() rc=0
  [ -f "$ETC/aicc-ops.toml" ] && cfg=(--config "$ETC/aicc-ops.toml")
  [ -x "$CLI" ] || { err "CLI not found at $CLI; cannot run telegram-check"; return 1; }
  if [ "$HARNESS" = 1 ]; then
    "$CLI" ${cfg[@]+"${cfg[@]}"} telegram-check || rc=$?
  elif [ "$(id -u)" -eq 0 ] && command -v runuser >/dev/null 2>&1 && id -u "$SVC_GROUP" >/dev/null 2>&1; then
    env -i PATH="$PATH" PYTHONDONTWRITEBYTECODE=1 runuser -u "$SVC_GROUP" -- "$CLI" ${cfg[@]+"${cfg[@]}"} telegram-check || rc=$?
  else
    env -i PATH="$PATH" PYTHONDONTWRITEBYTECODE=1 "$CLI" ${cfg[@]+"${cfg[@]}"} telegram-check || rc=$?
  fi
  return "$rc"
}

cmd_set_telegram() {
  local use_stdin=0 keep_token=0 chat_arg="" token="" chat="" ans
  while [ $# -gt 0 ]; do
    case "$1" in
      --stdin) use_stdin=1; shift ;;
      --keep-token) keep_token=1; shift ;;
      --chat-id) [ $# -ge 2 ] || die 2 "--chat-id needs a value"; chat_arg="$2"; shift 2 ;;
      *) die 2 "unknown argument for set-telegram: $1 (the token is never accepted as an argument)" ;;
    esac
  done
  require_root set-telegram
  if [ "$keep_token" = 1 ]; then
    token="$(existing_value BOT_TOKEN)"
    [ -n "$token" ] || die 2 "--keep-token: no TELEGRAM_BOT_TOKEN in $SECRETS yet (run set-telegram without --keep-token first)"
  elif [ "$use_stdin" = 1 ]; then
    IFS= read -r token || [ -n "$token" ] || die 2 "--stdin: no input on stdin"
    if [ -z "$chat_arg" ]; then IFS= read -r chat_arg || true; fi
  else
    [ -t 0 ] || die 3 "stdin is not a terminal: refusing to read a secret from a pipe (use --stdin explicitly if that is what you want)"
    # Echo is switched off BEFORE the prompt is printed (bash's `read -s` only does it afterwards), and restored by the EXIT trap.
    TTY_STATE="$(stty -g 2>/dev/null || true)"
    [ -n "$TTY_STATE" ] && stty -echo
    printf 'Telegram bot token (input hidden): ' >&2
    read -rs token || die 2 "no input"
    printf '\n' >&2
    [ -n "$TTY_STATE" ] && stty "$TTY_STATE" && TTY_STATE=""
  fi
  token="${token#"${token%%[![:space:]]*}"}"; token="${token%"${token##*[![:space:]]}"}"   # trim the ends only; an inner space stays and fails validation
  if [[ ! "$token" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]]; then
    token=""
    die 2 "that does not look like a Telegram bot token (expected <digits>:<30+ letters/digits/_/->); nothing was written"
  fi
  if [ -n "$chat_arg" ]; then
    chat="$chat_arg"
  elif [ "$use_stdin" = 0 ] && [ -t 0 ]; then
    read -r -p "Telegram chat id (Enter = keep current / set later with telegram-discover-chat): " ans || ans=""
    chat="$ans"
  fi
  chat="${chat#"${chat%%[![:space:]]*}"}"; chat="${chat%"${chat##*[![:space:]]}"}"
  if [ -z "$chat" ]; then chat="$(existing_value CHAT_ID)"; fi
  if [ -n "$chat" ] && [[ ! "$chat" =~ ^-?[0-9]{5,}$ ]]; then
    token=""
    die 2 "chat id must look like 123456789 or -1001234567890; nothing was written"
  fi
  write_secrets "$token" "$chat"
  token=""
  say "wrote $SECRETS (mode 0640, owner root:$SVC_GROUP); other keys in the file were kept."
  [ -n "$chat" ] || say "note: no chat id stored yet. Send your bot a message, run 'aicc-ops telegram-discover-chat', then: sudo aicc-ops-secrets set-telegram --keep-token"
  if run_check; then
    say "telegram-check: ok"
  else
    err "telegram-check FAILED (see above). The file was written; fix the token and run set-telegram again, or run remove-telegram."
    exit 1
  fi
  say "Nothing was restarted. To make the running service pick the credentials up, run:  systemctl restart aicc-ops"
}

cmd_status() {
  local mode owner keys=""
  if [ ! -e "$SECRETS" ]; then say "secrets file: absent ($SECRETS); Telegram is disabled"; return 0; fi
  if mode="$(stat -c '%a' "$SECRETS" 2>/dev/null)"; then owner="$(stat -c '%U:%G' "$SECRETS")"; else mode="$(stat -f '%Lp' "$SECRETS")"; owner="$(stat -f '%Su:%Sg' "$SECRETS")"; fi
  say "secrets file: present ($SECRETS)"
  say "owner: $owner"
  say "mode:  $mode"
  case "$mode" in 600|640) say "mode acceptable: yes" ;; *) say "mode acceptable: NO (AICC Ops refuses it unless 0600 or 0640)" ;; esac
  if [ -r "$SECRETS" ]; then
    [ -n "$(existing_value BOT_TOKEN)" ] && keys="TELEGRAM_BOT_TOKEN"
    [ -n "$(existing_value CHAT_ID)" ] && keys="${keys:+$keys }TELEGRAM_CHAT_ID"
    say "telegram keys: ${keys:-none}"
  else
    say "telegram keys: unknown (file not readable by this user; run with sudo)"
  fi
}

cmd_remove_telegram() {
  local yes=0 line other=0 ans
  while [ $# -gt 0 ]; do
    case "$1" in --yes) yes=1; shift ;; *) die 2 "unknown argument for remove-telegram: $1" ;; esac
  done
  require_root remove-telegram
  [ -e "$SECRETS" ] || { say "nothing to remove: $SECRETS does not exist"; return 0; }
  if [ "$yes" = 0 ]; then
    [ -t 0 ] || die 3 "not a terminal: pass --yes to confirm"
    read -r -p "Remove the Telegram credentials from $SECRETS? [y/N] " ans || ans=""
    [ "$ans" = y ] || [ "$ans" = Y ] || { say "aborted"; return 0; }
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ $KEY_RE ]] && continue
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    other=1
  done < "$SECRETS"
  if [ "$other" = 0 ]; then
    rm -f -- "$SECRETS"
    say "removed $SECRETS (it held nothing else)"
  else
    write_secrets "" ""
    say "removed the Telegram keys from $SECRETS (other keys kept)"
  fi
  say "Revoke the old token too: in Telegram, @BotFather -> /revoke."
  say "Nothing was restarted. To stop sending, run:  systemctl restart aicc-ops"
}

case "${1:-}" in
  set-telegram) shift; cmd_set_telegram "$@" ;;
  status) shift; cmd_status "$@" ;;
  remove-telegram) shift; cmd_remove_telegram "$@" ;;
  -h|--help|"") usage; [ -n "${1:-}" ] || exit 2 ;;
  *) err "unknown command: $1"; usage >&2; exit 2 ;;
esac
