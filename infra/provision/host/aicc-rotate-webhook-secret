#!/usr/bin/env python3
"""aicc-rotate-webhook-secret: the CONTROL PLANE half of the AICC_ENTITLEMENT_WEBHOOK_SECRET rotation. Runs ON THE CP HOST as root (sudo), normally started over SSH by the owner's
infra/provision/rotate-webhook-secret.sh on the Mac; never printed, never in an argument, an environment variable, a log or the journal.

    sudo aicc-rotate-webhook-secret status      [--id ID] [--expect-stage-id H]    fingerprints, registry check (RETIRED_SECRET_IN_USE), rotation journal
    sudo aicc-rotate-webhook-secret preflight   [--id ID] --expect-stage-id H      read-only checks; prints the outbox baseline
    sudo aicc-rotate-webhook-secret outbox                                         read-only: outbox pending / exhausted
    sudo aicc-rotate-webhook-secret prepare     --id ID --expect-stage-id H        generate the NEW secret on this host (secrets.token_hex(32)) as <live>.next-ID (0600 root, atomic)
    sudo aicc-rotate-webhook-secret emit-next   --id ID --expect-stage-id H        the new secret to STDOUT only (refuses a terminal): used inside the Mac's ssh | ssh pipe
    sudo aicc-rotate-webhook-secret promote     --id ID --expect-stage-id H --backend-already-restarted
                                                                                   keep the old as <live>.prev-ID, rename next over live, render the wp-config, reload php-fpm, confirm the rendered
                                                                                   constant's fingerprint; ANY failure restores the old secret automatically
    sudo aicc-rotate-webhook-secret probe-new                                      as aicc-cp (wp eval-file webhook-probe.php): the RUNNING constant signs a malformed-body probe; PASS = 400 webhook_payload_malformed
    sudo aicc-rotate-webhook-secret probe-old   --id ID                            as root: the previous secret signs the same probe; PASS = 401 webhook_signature_invalid
    sudo aicc-rotate-webhook-secret fingerprint [--which live|next|prev|retired|config] [--id ID]
    sudo aicc-rotate-webhook-secret rollback    --id ID --expect-stage-id H [--i-reinstate-a-retired-secret]
    sudo aicc-rotate-webhook-secret finalize    --id ID --expect-stage-id H

FILES (all root, 0600, in the 0700 secrets directory): /etc/aicc/secrets/entitlement-webhook.secret (live; 64 bytes, no newline), .next-ID, .prev-ID, .retired-ID. THIS TOOL NEVER DELETES A SECRET FILE OR A BACKUP.
Fingerprint = first 16 hex of SHA-256("aicc-webhook-secret-fingerprint-v1\\n" + secret): the only thing ever printed about a secret.
STATE: /var/lib/aicc/webhook-rotation/ID.state (0600, one line per phase with the UTC time, no secret); lock /var/lib/aicc/webhook-rotation/.lock (non-blocking flock: a second concurrent run is refused);
RETIRED REGISTRY: /etc/aicc/webhook-secret-retired.fp (0600, lines `<fp16> <UTC time> <id>`); `status` fails with RETIRED_SECRET_IN_USE when the live secret is in it.
AUDIT: one `logger -t aicc-webhook-rotate` line per change (action, id, phase, fingerprint PREFIXES only).
ATOMICITY: every write is O_EXCL temp + fsync + rename in the same directory: a killed process leaves the old file or the new file, never a partial one; stale temp files are swept by the next locked run.
TEST SEAMS (honoured ONLY with AICC_TEST_HARNESS=1 and an AICC_ROOT_PREFIX directory under the system temp dir; loud banner): AICC_ROOT_PREFIX re-roots the absolute paths and the owner becomes the
calling user; AICC_TEST_KILL_AT=<stage> kills the process at a stage; AICC_TEST_NEW_SECRET_FILE names a file holding the secret `prepare` should use; AICC_TEST_NO_FSYNC=1 skips fsync (slow fixture volume); AICC_TEST_SHORT_WRITE=1 simulates a short write; --backend-url points the probes at a local fake.
"""
import os
import sys

if not sys.flags.isolated and "__file__" in globals():     # the isolated-mode re-exec comes BEFORE any other import: nothing from the caller's directory or environment can be imported first
    os.execv(sys.executable, [sys.executable, "-I", os.path.abspath(__file__)] + sys.argv[1:])

import argparse
import ctypes
import fcntl
import grp
import hashlib
import hmac
import json
import re
import resource
import secrets
import signal
import stat
import subprocess
import time
import urllib.error
import urllib.request

NAME = "aicc-rotate-webhook-secret"
FP_TAG = b"aicc-webhook-secret-fingerprint-v1\n"
SIGN_TAG = b"aicc-entitlement-webhook-v1\n"
PROBE_BODY = b'{"probe":"aicc-webhook-rotation"}'
PRODUCTION_HOSTNAME = "www.copilt.org"
DEFAULT_BACKEND = "https://api.copilt.org"
WEBHOOK_PATH = "/v1/internal/entitlement/webhook"
ID_RE = re.compile(r"[0-9]{8}T[0-9]{6}Z")
SECRET_RE = re.compile(rb"[A-Za-z0-9._~+/=-]{32,}")       # the renderer's rule (render-wp-config.sh), plus at least 12 distinct characters
HEX64_RE = re.compile(rb"[0-9a-f]{64}")
PHASES = ("prepared", "promote-begin", "promoted", "promote-failed", "rolled-back", "finalized")
TERMINAL = ("rolled-back", "finalized")
HARNESS = os.environ.get("AICC_TEST_HARNESS") == "1"
PREFIX = ""


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (NAME, msg))
    sys.exit(code)


def say(msg=""):
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


HARNESS_ROOTS = ("/tmp", "/var/tmp", "/private/tmp", "/private/var/folders")      # fixed allow-list: $TMPDIR is NEVER consulted
HARNESS_SENTINEL = ".aicc-test-harness-root"


def harness_gate(p):
    """The test seams re-root every path, so they are refused unless the prefix is an unmistakable scratch directory: an absolute CANONICAL path (no symlinked or relative component, not /), strictly below the fixed
    temp allow-list, carrying the sentinel file the fixture creates, never when running as root under sudo. Returns the prefix or dies."""
    why = "AICC_TEST_HARNESS=1 needs AICC_ROOT_PREFIX to be an existing directory under the system temp dir (the seams are for tests only)"
    if not p or not os.path.isabs(p) or p != os.path.normpath(p):
        die("REFUSED: %s [not an absolute normalised path]" % why)
    if not os.path.isdir(p) or os.path.realpath(p) != p or p == "/":
        die("REFUSED: %s [not an existing canonical directory: a symlinked component or / is refused]" % why)
    if not any(p.startswith(r + "/") for r in HARNESS_ROOTS):
        die("REFUSED: %s [outside %s]" % (why, ", ".join(HARNESS_ROOTS)))
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        die("REFUSED: the test seams are never honoured by root running under sudo (SUDO_USER is set)")
    st = None
    try:
        st = os.lstat(os.path.join(p, HARNESS_SENTINEL))
    except OSError:
        pass
    if st is None or not stat.S_ISREG(st.st_mode):
        die("REFUSED: %s [the prefix has no %s sentinel file]" % (why, HARNESS_SENTINEL))
    return p


def harden_process():
    """No core dump and not dumpable (best effort): a crash must not write the secret into a core file or let a same-user process read /proc/<pid>/mem."""
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except Exception:
        pass
    try:
        ctypes.CDLL(None).prctl(4, 0, 0, 0, 0)      # PR_SET_DUMPABLE = 4
    except Exception:
        pass


harden_process()
if HARNESS:
    PREFIX = harness_gate(os.environ.get("AICC_ROOT_PREFIX", ""))
    sys.stderr.write("%s: *** TEST HARNESS ACTIVE: paths re-rooted under %s, owner/kill/secret-file seams honoured. Never set this on a real host. ***\n" % (NAME, PREFIX))
else:
    os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def P(path):
    return PREFIX + path


SECDIR = P("/etc/aicc/secrets")
LIVE = SECDIR + "/entitlement-webhook.secret"
STATEDIR = P("/var/lib/aicc/webhook-rotation")
LOCKF = STATEDIR + "/.lock"
REGISTRY = P("/etc/aicc/webhook-secret-retired.fp")
CONFIG = P("/srv/aicc/shared/wp-config.php")
IDENT = P("/etc/aicc-stage-identity")
PROBE_PHP = P("/usr/local/lib/aicc/webhook-probe.php")
SYSTEMD_FPM = "php8.3-fpm"
SNAPSHOT_PHP = P("/usr/local/lib/aicc/outbox-snapshot.php")
ATTEMPT_REFUSE = 6        # a pending event at this many failed attempts (of 8) could be exhausted by the mismatch window: a rotation does not start
SUDOERS_FILES = (P("/etc/sudoers"), P("/etc/sudoers.d"))


def kill_at(stage):
    if HARNESS and os.environ.get("AICC_TEST_KILL_AT") == stage:
        os.kill(os.getpid(), signal.SIGKILL)


def pause(sec):
    time.sleep(min(sec, 0.2) if HARNESS else sec)


def utcnow():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def owner_ids():
    """(uid, gid) every secret file must have: root:root on the host; the calling user in the test harness."""
    return (os.getuid(), os.getgid()) if HARNESS else (0, 0)


# ---- fingerprints and validation ---------------------------------------------------------------------------------------------------------------------------------------------------------------
def fp(secret):
    return hashlib.sha256(FP_TAG + secret).hexdigest()[:16]


def valid_secret(b):
    return SECRET_RE.fullmatch(b) is not None and len(set(b)) >= 12


def redact(text):
    return re.sub(r"[A-Za-z0-9_+]{41,}", "<long-token-hidden>", text)


# ---- files -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
def fsync(fd):
    """os.fsync, except in the test harness when AICC_TEST_NO_FSYNC=1 (the fixture's temp volume fsyncs slowly; a killed process never loses page-cache data, so the atomicity tests do not need it)."""
    if HARNESS and os.environ.get("AICC_TEST_NO_FSYNC") == "1":
        return
    os.fsync(fd)


def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path, data, tag, mode=0o600):
    """O_EXCL temp (0400 until complete) in the SAME directory, short-write check, fsync, rename over the target, fsync of the directory. A killed process leaves the old file or the new file."""
    d, base = os.path.dirname(path), os.path.basename(path)
    uid, gid = owner_ids()
    tmp = os.path.join(d, ".%s.new.%d" % (base, os.getpid()))
    old = os.umask(0o277)
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    finally:
        os.umask(old)
    try:
        kill_at(tag + "_after_create")
        chunk = data[:-3] if (HARNESS and os.environ.get("AICC_TEST_SHORT_WRITE") == "1") else data
        n = os.write(fd, chunk)
        if n != len(data) or os.fstat(fd).st_size != len(data):
            die("REFUSED: %s was not written completely (wrote %d of %d bytes); the existing file was NOT touched" % (base, n, len(data)))
        kill_at(tag + "_after_write")
        os.fchown(fd, uid, gid)
        os.fchmod(fd, mode)
        fsync(fd)
        kill_at(tag + "_after_fsync")
    except BaseException:
        os.close(fd)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.close(fd)
    os.replace(tmp, path)
    kill_at(tag + "_after_rename")
    fsync_dir(d)


def sweep_temps():
    """Stale temp files of a killed run (only called while the lock is held, so nobody else can be writing one)."""
    for d in (SECDIR, os.path.dirname(REGISTRY), STATEDIR):
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if re.fullmatch(r"\.(entitlement-webhook\.secret[A-Za-z0-9.-]*|webhook-secret-retired\.fp|[0-9]{8}T[0-9]{6}Z\.events)\.new\.[0-9]+", n):
                p = os.path.join(d, n)
                if stat.S_ISREG(os.lstat(p).st_mode):
                    os.unlink(p)


def lstat_or_none(path):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        return None


def read_secret(path, what):
    """The secret in a regular file (never a symlink), whitespace-stripped like the renderer does; refuses anything that is not a valid secret. The value is returned to the caller only."""
    st = lstat_or_none(path)
    if st is None:
        die("REFUSED: %s is missing" % what)
    if not stat.S_ISREG(st.st_mode):
        die("REFUSED: %s is not a regular file (a symbolic link or special file is never used)" % what)
    with open(path, "rb") as f:
        raw = f.read(300)
    v = raw.strip()
    if not valid_secret(v):
        die("REFUSED: %s does not hold a valid secret (at least 32 characters from [A-Za-z0-9._~+/=-], at least 12 distinct)" % what)
    return v


def file_problems(path):
    st = lstat_or_none(path)
    if st is None:
        return ["missing"]
    out = []
    uid, gid = owner_ids()
    if not stat.S_ISREG(st.st_mode):
        return ["not a regular file"]
    if st.st_uid != uid or st.st_gid != gid:
        out.append("owner is not root:root")
    if stat.S_IMODE(st.st_mode) != 0o600:
        out.append("mode is %04o, expected 0600" % stat.S_IMODE(st.st_mode))
    return out


def nextp(i):
    return "%s.next-%s" % (LIVE, i)


def prevp(i):
    return "%s.prev-%s" % (LIVE, i)


def retiredp(i):
    return "%s.retired-%s" % (LIVE, i)


def config_fp():
    """(fingerprint, note): the fingerprint of the AICC_ENTITLEMENT_WEBHOOK_SECRET the RENDERED wp-config defines (parsed in memory, never printed)."""
    try:
        with open(CONFIG, "rb") as f:
            text = f.read()
    except OSError:
        return None, "the rendered wp-config is missing or unreadable"
    m = re.findall(rb"(?m)^define\( 'AICC_ENTITLEMENT_WEBHOOK_SECRET', '([^']*)' \);", text)
    if len(m) != 1:
        return None, "the rendered wp-config does not define the constant exactly once (%d)" % len(m)
    return fp(m[0]), ""


# ---- state journal, lock, registry, audit ----------------------------------------------------------------------------------------------------------------------------------------------
def ensure_statedir():
    os.makedirs(STATEDIR, mode=0o700, exist_ok=True)
    os.chmod(STATEDIR, 0o700)


def state_path(i):
    return os.path.join(STATEDIR, "%s.state" % i)


def state_lines(i):
    """[(time, phase, {k: v})] of one rotation, oldest first."""
    out = []
    try:
        with open(state_path(i), "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1].startswith("phase="):
                    kv = dict(p.split("=", 1) for p in parts[2:] if "=" in p)
                    out.append((parts[0], parts[1][6:], kv))
    except OSError:
        pass
    return out


def last_phase(i):
    ph = [p for (_, p, _) in state_lines(i) if p in PHASES]
    return ph[-1] if ph else None


def phase_value(i, key):
    for (_, p, kv) in reversed(state_lines(i)):
        if key in kv:
            return kv[key]
    return None


def append_state(i, phase, **kv):
    ensure_statedir()
    fields = " ".join("%s=%s" % (k, re.sub(r"[^A-Za-z0-9._:/,=+-]", "_", str(v))) for k, v in sorted(kv.items()))
    line = "%s phase=%s%s\n" % (utcnow(), phase, (" " + fields) if fields else "")
    fd = os.open(state_path(i), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, line.encode())
        fsync(fd)
    finally:
        os.close(fd)


def audit(action, i, phase, **fps):
    parts = ["action=%s" % action, "id=%s" % i, "phase=%s" % phase, "operator=%s" % os.environ.get("SUDO_USER", "root")]
    parts += ["%s_prefix=%s" % (k, str(v)[:8]) for k, v in sorted(fps.items())]
    try:
        subprocess.run(["logger", "-t", "aicc-webhook-rotate", "--", " ".join(parts)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def take_lock():
    """Non-blocking exclusive flock: two concurrent rotations can never interleave. Held until the process exits."""
    ensure_statedir()
    fd = os.open(LOCKF, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("REFUSED: another %s is running (the rotation lock is held); wait for it, run `status`, then retry" % NAME)
    return fd


def unfinished_other(i):
    try:
        names = sorted(os.listdir(STATEDIR))
    except OSError:
        return None
    for n in names:
        m = re.fullmatch(r"([0-9]{8}T[0-9]{6}Z)\.state", n)
        if m and m.group(1) != i:
            lp = last_phase(m.group(1))
            if lp is not None and lp not in TERMINAL:
                return m.group(1), lp
    return None


def registry_entries():
    out = []
    try:
        with open(REGISTRY, "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and re.fullmatch(r"[0-9a-f]{16}", parts[0]):
                    out.append((parts[0], parts[1], parts[2]))
    except OSError:
        pass
    return out


def registry_add(old_fp, i):
    entries = registry_entries()
    if any(e[2] == i for e in entries):
        return False
    text = "".join("%s %s %s\n" % e for e in entries) + "%s %s %s\n" % (old_fp, utcnow(), i)
    atomic_write(REGISTRY, text.encode(), "cp_registry")
    return True


# ---- host identity -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
def check_identity(expect_id, required):
    if not required and not expect_id:
        return
    try:
        with open(IDENT) as f:
            lines = f.read().splitlines()
    except OSError:
        die("REFUSED: no host identity (%s)" % "/etc/aicc-stage-identity")
    if "AICC_ENV=production" not in lines:
        die("REFUSED: this host's identity does not say AICC_ENV=production")
    if "AICC_HOSTNAME=%s" % PRODUCTION_HOSTNAME not in lines:
        die("REFUSED: this host's identity is not %s" % PRODUCTION_HOSTNAME)
    if required and not expect_id:
        die("REFUSED: --expect-stage-id is required for this mode")
    if expect_id:
        if not re.fullmatch(r"[0-9a-f]{32}", expect_id):
            die("REFUSED: --expect-stage-id must be 32 hex characters")
        if "AICC_STAGE_ID=%s" % expect_id not in lines:
            die("REFUSED: the host's stage id differs from --expect-stage-id (wrong machine?)")


# ---- subprocesses and the Backend probe ----------------------------------------------------------------------------------------------------------------------------------------------
def run(cmd, timeout=180):
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    except FileNotFoundError:
        return 127, "%s: command not found" % cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "%s: timed out after %ds" % (cmd[0], timeout)
    return r.returncode, redact(r.stdout.decode("utf-8", "replace")).strip()


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


def error_code(body):
    code = None
    try:
        j = json.loads(body.decode("utf-8", "replace"))
        d = j.get("detail", j) if isinstance(j, dict) else None
        if isinstance(d, dict) and isinstance(d.get("error"), str):
            code = d["error"]
        elif isinstance(j, dict) and isinstance(j.get("error"), str):
            code = j["error"]
    except Exception:
        pass
    if code is None:
        m = re.search(rb"(webhook_[a-z_]+|entitlement_webhook_not_configured)", body)
        code = m.group(1).decode() if m else "none"
    return code if re.fullmatch(r"[a-z_]{1,64}", code) else "unrecognised"


def post_probe(base, secret):
    """The NON-MUTATING probe: valid JSON that lacks the required fields, signed with `secret`. The Backend checks the signature BEFORE it parses the payload: 400 webhook_payload_malformed = the
    signature is right; 401 webhook_signature_invalid = the secret is wrong. It never touches the database. The secret stays in this process (HMAC in memory)."""
    ts = int(time.time())
    sig = hmac.new(secret, SIGN_TAG + str(ts).encode() + b"\n" + PROBE_BODY, hashlib.sha256).hexdigest()
    req = urllib.request.Request(base.rstrip("/") + WEBHOOK_PATH, data=PROBE_BODY, method="POST",
                                 headers={"Content-Type": "application/json", "X-AICC-Webhook-Timestamp": str(ts), "X-AICC-Webhook-Signature": sig, "User-Agent": "aicc-webhook-rotation-probe/1"})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect)
    try:
        resp = opener.open(req, timeout=20)
        return resp.status, error_code(resp.read(4096)), ""
    except urllib.error.HTTPError as e:
        return e.code, error_code(e.read(4096)), ""
    except Exception as e:
        return None, "none", type(e).__name__


def backend_url(args):
    if args.backend_url:
        if not HARNESS:
            die("REFUSED: --backend-url is a test seam (AICC_TEST_HARNESS=1 only); the probe always targets %s" % DEFAULT_BACKEND)
        if not re.fullmatch(r"http://127\.0\.0\.1:[0-9]{2,5}", args.backend_url):
            die("REFUSED: the test backend url must be http://127.0.0.1:<port>")
        return args.backend_url
    return DEFAULT_BACKEND


# ---- outbox, render, reload ------------------------------------------------------------------------------------------------------------------------------------------------------------
def outbox():
    """{'available','pending','exhausted','oldest'} from `aicc-wp aicc-mail health` (JSON, license_outbox), or None."""
    rc, txt = run(["aicc-wp", "aicc-mail", "health"], 120)
    if rc != 0:
        return None
    a, b = txt.find("{"), txt.rfind("}")
    try:
        j = json.loads(txt[a:b + 1])
        lo = j["license_outbox"]
        return {"available": bool(lo.get("available")), "pending": int(lo["pending"]), "exhausted": int(lo["exhausted"]), "oldest": lo.get("oldest_pending_age_seconds")}
    except Exception:
        return None


def render_and_reload():
    """(ok, message): render the production wp-config from the secrets directory, reload php-fpm (one retry: a reload can fail once and succeed 2 s later, seen on the host)."""
    rc, txt = run(["aicc-render-wp-config", "--env", "production", "--confirm-production"], 180)
    if rc != 0:
        return False, "the render failed (exit %d): %s" % (rc, txt.splitlines()[-1] if txt else "no output")
    kill_at("cp_after_render")
    rc, txt = run(["systemctl", "reload", SYSTEMD_FPM], 60)
    if rc != 0:
        pause(3)
        rc, txt = run(["systemctl", "reload", SYSTEMD_FPM], 60)
        if rc != 0:
            return False, "the php-fpm reload failed twice (exit %d): %s" % (rc, txt.splitlines()[-1] if txt else "no output")
    kill_at("cp_after_reload")
    return True, ""


def config_matches(want):
    got, note = config_fp()
    if got is None:
        return False, note
    if got != want:
        return False, "the rendered wp-config holds fingerprint %s, expected %s" % (got, want)
    st = lstat_or_none(CONFIG)
    if st is not None and stat.S_IMODE(st.st_mode) != 0o640:
        return False, "the rendered wp-config has mode %04o, expected 0640" % stat.S_IMODE(st.st_mode)
    return True, ""


# ---- modes -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
def snapshot():
    """{'pending': {event_id: attempts}, 'exhausted': {event_id: attempts}} from outbox-snapshot.php (one read-only SELECT through `aicc-wp eval-file`, as aicc-cp), or None when it cannot be read completely."""
    rc, txt = run(["aicc-wp", "eval-file", SNAPSHOT_PHP], 120)
    pend, exh, total = {}, {}, None
    for line in txt.splitlines():
        line = line.strip()
        m = re.fullmatch(r"(EVENT|EXHAUSTED) ([A-Za-z0-9-]{1,40}) attempts=([0-9]{1,3})", line)
        if m:
            (pend if m.group(1) == "EVENT" else exh)[m.group(2)] = int(m.group(3))
            continue
        m = re.fullmatch(r"TOTAL pending=([0-9]+) exhausted=([0-9]+) listed=([0-9]+)", line)
        if m:
            total = tuple(int(x) for x in m.groups())
    if rc != 0 or total is None or total[0] != len(pend) or total[1] != len(exh) or total[2] >= 1000:
        return None
    return {"pending": pend, "exhausted": exh}


def events_path(i):
    return os.path.join(STATEDIR, "%s.events" % i)


def load_baseline_events(i):
    """{event_id: attempts} of the events that were pending BEFORE this rotation changed anything, or None."""
    try:
        with open(events_path(i), "r") as f:
            out = {}
            for line in f:
                m = re.fullmatch(r"E ([A-Za-z0-9-]{1,40}) ([0-9]{1,3})", line.strip())
                if m:
                    out[m.group(1)] = int(m.group(2))
            return out
    except OSError:
        return None


def outbox_problems(snap):
    """Reasons a rotation must not start: exhausted events, or pending events close to exhaustion."""
    out = []
    if snap["exhausted"]:
        out.append("%d exhausted event(s) already (never deleted; AICC_LM_Entitlement_Dispatcher::reconcile_exhausted() may re-queue them: docs/cutover/p38-webhook-rotation.md section 6b)" % len(snap["exhausted"]))
    hot = sorted(k for k, n in snap["pending"].items() if n >= ATTEMPT_REFUSE)
    if hot:
        out.append("%d pending event(s) at %d or more failed attempts (of 8): one failed delivery in the mismatch window could exhaust them (wait until they are delivered)" % (len(hot), ATTEMPT_REFUSE))
    return out


def drain_state(i):
    """('ok'|'waiting'|'exhausted'|'unreadable'|'nobaseline', detail dict) for rotation i: every event that is still pending must have been pending BEFORE the rotation."""
    base = load_baseline_events(i)
    if base is None:
        return "nobaseline", {}
    snap = snapshot()
    if snap is None:
        return "unreadable", {}
    new_pending = sorted(k for k in snap["pending"] if k not in base)
    still = [k for k in snap["pending"] if k in base]
    d = {"new_pending": len(new_pending), "exhausted": len(snap["exhausted"]), "baseline_still_pending": len(still), "baseline_retried": sum(1 for k in still if snap["pending"][k] > base[k]), "exhausted_ids": sorted(snap["exhausted"])}
    if snap["exhausted"]:
        return "exhausted", d
    return ("waiting" if new_pending else "ok"), d


def sudo_logging_warnings():
    """sudo I/O logging records the output (log_output) and input (log_input) of the commands it runs: the new secret is written to stdout by `emit-next` and read from stdin by `stage`. Static grep of sudoers; WARN only."""
    out = []
    files = []
    for base in SUDOERS_FILES:
        if os.path.isdir(base):
            files += [os.path.join(base, n) for n in sorted(os.listdir(base))]
        elif os.path.isfile(base):
            files.append(base)
    for f in files:
        try:
            with open(f, "r", errors="replace") as fh:
                for line in fh:
                    code = line.split("#", 1)[0]
                    if re.search(r"\bDefaults\b", code) and re.search(r"\b(log_output|log_input|iolog_dir|iolog_file|LOG_OUTPUT|LOG_INPUT)\b", code) and not re.search(r"!\s*(log_output|log_input)", code):
                        out.append(os.path.basename(f))
                        break
        except OSError:
            continue
    return out


def need_id(args):
    if not args.id or not ID_RE.fullmatch(args.id):
        die("REFUSED: --id must look like 20261117T182030Z (UTC time of the rotation)")
    return args.id


def live_state():
    """(secret|None, fingerprint|None) of the live file; refuses a symlink / invalid file with a clear message."""
    v = read_secret(LIVE, "the live secret file")
    return v, fp(v)


def do_status(args):
    problems = 0
    st = lstat_or_none(LIVE)
    if st is None:
        say("live: ABSENT %s" % "/etc/aicc/secrets/entitlement-webhook.secret")
        return 1
    lf = None
    try:
        v, lf = live_state()
        pr = file_problems(LIVE)
        say("live: fp=%s file=/etc/aicc/secrets/entitlement-webhook.secret %s" % (lf, "mode/owner ok" if not pr else "FILE PROBLEM: " + ", ".join(pr)))
        problems += 1 if pr else 0
    except SystemExit:
        say("live: UNUSABLE (not a regular file or not a valid secret)")
        problems += 1
    cf, note = config_fp()
    if cf is None:
        say("config: UNKNOWN (%s)" % note)
        problems += 1
    else:
        say("config: fp=%s match=%s" % (cf, "yes" if cf == lf else "NO"))
        if cf != lf:
            say("CONFIG_MISMATCH: the rendered wp-config and the live secret file differ; run a render or investigate before anything else")
            problems += 1
    reg = registry_entries()
    say("registry: %d retired fingerprint(s)" % len(reg))
    if lf is not None and any(e[0] == lf for e in reg):
        say("RETIRED_SECRET_IN_USE: the live secret of the Control Plane is a RETIRED secret (an old backup was restored?): it must not be used. Run a new rotation.")
        problems += 1
    if cf is not None and any(e[0] == cf for e in reg):
        say("RETIRED_SECRET_IN_USE: the RENDERED wp-config defines a RETIRED secret. Run a new rotation.")
        problems += 1
    ids = []
    for n in (sorted(os.listdir(STATEDIR)) if os.path.isdir(STATEDIR) else []):
        m = re.fullmatch(r"([0-9]{8}T[0-9]{6}Z)\.state", n)
        if m:
            ids.append(m.group(1))
    for rid in ids:
        lp = last_phase(rid)
        ts = [t for (t, p, _) in state_lines(rid) if p == lp][-1:] or ["?"]
        say("rotation: id=%s phase=%s at=%s%s" % (rid, lp, ts[0], "" if lp in TERMINAL else " UNFINISHED"))
        if lp not in TERMINAL:
            say("UNFINISHED id=%s phase=%s" % (rid, lp))
    if ids:
        lp = last_phase(ids[-1])
        ts = [t for (t, p, _) in state_lines(ids[-1]) if p == lp][-1:] or ["?"]
        say("LATEST id=%s phase=%s at=%s" % (ids[-1], lp, ts[0]))
    if args.id:
        for (t, p, kv) in state_lines(args.id):
            say("journal %s phase=%s %s" % (t, p, " ".join("%s=%s" % kv_ for kv_ in sorted(kv.items()))))
        for which, path in (("next", nextp(args.id)), ("prev", prevp(args.id)), ("retired", retiredp(args.id))):
            if lstat_or_none(path) is not None:
                try:
                    say("file %s: present fp=%s" % (which, fp(read_secret(path, which))))
                except SystemExit:
                    say("file %s: present but UNUSABLE" % which)
    return 3 if problems else 0


def do_preflight(args):
    fails = []

    def ok(m):
        say("ok: " + m)

    def fail(m):
        say("FAIL: " + m)
        fails.append(m)
    ok("host identity: production, %s, stage id verified" % PRODUCTION_HOSTNAME)
    inprog = bool(args.id) and last_phase(args.id) in ("promote-begin", "promote-failed")     # a resumed promote: the file and the rendered config may legitimately differ until it is re-rendered
    lf = None
    pr = file_problems(LIVE)
    if pr:
        fail("live secret file: " + ", ".join(pr))
    else:
        try:
            v, lf = live_state()
            ok("live secret file: root 0600 regular file, valid secret, fp=%s" % lf)
        except SystemExit:
            fail("live secret file does not hold a valid secret")
    cf, note = config_fp()
    if cf is None:
        fail("rendered wp-config: " + note)
    elif lf is not None and cf != lf and inprog:
        ok("note: the rendered wp-config (fp %s) differs from the live file (fp %s) because the promote of %s was interrupted; resume re-renders it" % (cf, lf, args.id))
    elif lf is not None and cf != lf:
        fail("CONFIG_MISMATCH: the rendered wp-config (fp %s) differs from the live secret file (fp %s): re-render first, then plan again" % (cf, lf))
    elif lf is not None:
        ok("the rendered wp-config defines the live secret (fp match)")
    reg = registry_entries()
    if lf is not None and any(e[0] == lf for e in reg):
        if args.replace_retired_secret:
            say("WARNING: the live secret (fp %s) is a RETIRED one (an old backup was restored?). --replace-retired-secret: this rotation replaces it; it is exposed until the cutover is done." % lf)
            ok("the live secret is in the retired registry and --replace-retired-secret was given: the rotation is the cure")
        else:
            fail("RETIRED_SECRET_IN_USE: the live secret is a retired one: re-run with --replace-retired-secret (a rotation replaces it; the NEW secret is still refused if it is retired)")
    else:
        ok("the live secret is not in the retired registry (%d entries)" % len(reg))
    other = unfinished_other(args.id or "")
    if other:
        fail("an earlier rotation is unfinished: id=%s phase=%s (resume it or roll it back first)" % other)
    else:
        ok("no unfinished rotation")
    for tool in ("aicc-render-wp-config", "aicc-wp", "systemctl", "logger"):
        found = any(os.access(os.path.join(d, tool), os.X_OK) for d in os.environ["PATH"].split(":"))
        ok("tool present: " + tool) if found else fail("tool missing: " + tool)
    if os.access(PROBE_PHP, os.R_OK):
        ok("probe script present: /usr/local/lib/aicc/webhook-probe.php")
    else:
        fail("probe script missing: /usr/local/lib/aicc/webhook-probe.php (install-stack.sh installs it)")
    rc, txt = run(["systemctl", "is-active", SYSTEMD_FPM], 30)
    ok("%s is active" % SYSTEMD_FPM) if (rc == 0 and txt.strip() == "active") else fail("%s is not active (%s)" % (SYSTEMD_FPM, txt[:40]))
    rc, txt = (0, "") if inprog else run(["aicc-render-wp-config", "--env", "production", "--confirm-production", "--compare"], 180)
    if inprog:
        ok("render comparison skipped: the promote of %s is being resumed" % args.id)
    elif rc == 0:
        ok("a render reproduces the live wp-config byte for byte (a promote changes only the secret)")
    else:
        fail("a render would change the wp-config BEFORE the secret changes (exit %d); constants by name: %s" % (rc, " | ".join(x.strip() for x in txt.splitlines()[-4:])))
    snap = snapshot()
    if snap is None:
        fail("the pending outbox events could not be listed (outbox-snapshot.php through aicc-wp eval-file): the rotation cannot show event by event that nothing is lost")
    else:
        for prob in outbox_problems(snap):
            fail("outbox: " + prob)
        if not outbox_problems(snap):
            ok("outbox events: %d pending, none at %d or more failed attempts, none exhausted" % (len(snap["pending"]), ATTEMPT_REFUSE))
    if os.access(SNAPSHOT_PHP, os.R_OK):
        ok("outbox snapshot script present: /usr/local/lib/aicc/outbox-snapshot.php")
    else:
        fail("outbox snapshot script missing: /usr/local/lib/aicc/outbox-snapshot.php (install-stack.sh installs it)")
    for f in sudo_logging_warnings():
        say("WARN: sudo I/O logging (log_output / log_input / iolog) is configured in sudoers file `%s`: the secret passes through `sudo` here (emit-next writes it to stdout). A root-only I/O log would hold it: remove the setting for this tool, or accept it knowingly." % f)
    ob = outbox()
    if ob is None:
        fail("the outbox health could not be read (aicc-wp aicc-mail health)")
    elif not ob["available"]:
        fail("the licence outbox reports available=false: events cannot be shown to survive")
    elif ob["exhausted"] != 0:
        fail("the outbox already has %d exhausted event(s): resolve them first (the rotation requires exhausted == 0 afterwards)" % ob["exhausted"])
    else:
        ok("outbox: available, exhausted 0")
    if ob is not None:
        say("OUTBOX pending=%d exhausted=%d oldest=%s" % (ob["pending"], ob["exhausted"], ob["oldest"]))
    say("PREFLIGHT %s" % ("FAILED (%d)" % len(fails) if fails else "OK"))
    return 1 if fails else 0


def do_outbox(args):
    ob = outbox()
    if ob is None or not ob["available"]:
        say("FAIL: the outbox health could not be read or reports available=false")
        return 1
    say("OUTBOX pending=%d exhausted=%d oldest=%s" % (ob["pending"], ob["exhausted"], ob["oldest"]))
    return 0


def do_prepare(args):
    i = need_id(args)
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp in ("promote-begin", "promoted", "promote-failed", "finalized"):
        say("already past prepare: id=%s phase=%s (nothing changed)" % (i, lp))
        return 0
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back; start a new rotation with a new id" % i)
    other = unfinished_other(i)
    if other:
        die("REFUSED: an earlier rotation is unfinished: id=%s phase=%s (resume it or roll it back first)" % other)
    v, lf = live_state()
    if file_problems(LIVE):
        die("REFUSED: the live secret file is not root 0600 (%s)" % ", ".join(file_problems(LIVE)))
    n = nextp(i)
    if load_baseline_events(i) is None and lp in (None, "prepared"):
        snap = snapshot()
        if snap is None:
            die("REFUSED: the pending outbox events could not be listed (nothing was changed)")
        probs = outbox_problems(snap)
        if probs:
            die("REFUSED: outbox: %s (nothing was changed)" % "; ".join(probs))
        atomic_write(events_path(i), ("".join("E %s %d\n" % (k, v_) for k, v_ in sorted(snap["pending"].items()))).encode(), "cp_events")
    base = {}
    if args.baseline_pending is not None:
        base["baseline_pending"] = args.baseline_pending
    if args.baseline_exhausted is not None:
        base["baseline_exhausted"] = args.baseline_exhausted
    if lstat_or_none(n) is not None:
        nv = read_secret(n, "the prepared secret of this id")
        nf = fp(nv)
        if file_problems(n):
            die("REFUSED: %s: %s" % ("the prepared secret file", ", ".join(file_problems(n))))
        say("already prepared: id=%s next_fp=%s live_fp=%s (nothing changed)" % (i, nf, lf))
        if lp is None or phase_value(i, "next_fp") != nf:
            append_state(i, "prepared", next_fp=nf, old_fp=lf, **base)
        return 0
    if HARNESS and os.environ.get("AICC_TEST_NEW_SECRET_FILE"):
        with open(os.environ["AICC_TEST_NEW_SECRET_FILE"], "rb") as f:
            new = f.read().strip()
    else:
        new = secrets.token_hex(32).encode()
    if not HEX64_RE.fullmatch(new) or not valid_secret(new):
        die("REFUSED: the generated secret failed the renderer's validation rule (not written)")
    nf = fp(new)
    if nf == lf or any(e[0] == nf for e in registry_entries()):
        die("REFUSED: the new secret equals the live or a retired one (not written; run prepare again)")
    # the journal line (the INTENT, with the fingerprint only) is written BEFORE the file: a process killed in between leaves a journalled id the orchestrator can resume or roll back,
    # never a secret file nobody knows about; a re-run with no file simply generates and journals again
    append_state(i, "prepared", next_fp=nf, old_fp=lf, **base)
    kill_at("cp_after_journal")
    atomic_write(n, new, "cp_prepare")
    audit("prepare", i, "prepared", next_fp=nf, old_fp=lf)
    say("prepared: id=%s next_fp=%s live_fp=%s file=%s root 0600 (the live secret is unchanged)" % (i, nf, lf, "/etc/aicc/secrets/entitlement-webhook.secret.next-" + i))
    return 0


def do_emit_next(args):
    i = need_id(args)
    if os.isatty(1):
        die("REFUSED: stdout is a terminal; the new secret is written to a pipe only (the Mac's ssh | ssh transfer)")
    if lstat_or_none(nextp(i)) is None:
        die("REFUSED: no prepared secret for id %s (not prepared, or already promoted)" % i)
    if file_problems(nextp(i)):
        die("REFUSED: the prepared secret file: %s" % ", ".join(file_problems(nextp(i))))
    v = read_secret(nextp(i), "the prepared secret of this id")
    if not HEX64_RE.fullmatch(v):
        die("REFUSED: the prepared secret is not 64 hex characters")
    data = v + b"\n"
    mode_ = os.environ.get("AICC_TEST_EMIT_MODE", "") if HARNESS else ""
    if mode_ == "wrongsecret":
        data = hashlib.sha256(v).hexdigest().encode() + b"\n"       # a DIFFERENT, valid-looking secret: the receiver accepts it, only the fingerprint comparison can catch it
    elif mode_ == "truncate":
        data = data[:-3] + b"\n"
    off = 0
    while off < len(data):
        off += os.write(1, data[off:])
    if mode_ == "exit1":
        sys.exit(1)       # the whole secret was written, then the tool "failed": the receiving end would accept it
    try:
        append_state(i, "emitted", next_fp=fp(v))
    except OSError:
        pass
    audit("emit-next", i, "emitted", next_fp=fp(v))
    return 0


def restore_prev(i, why):
    """Put the previous secret back (atomic), render, reload, confirm. Returns (ok, message). The NEW secret is kept as .next-ID so nothing is lost."""
    pv = read_secret(prevp(i), "the preserved previous secret")
    pf = fp(pv)
    cur = lstat_or_none(LIVE)
    if cur is not None:
        try:
            curv = read_secret(LIVE, "the live secret file")
            if curv != pv and lstat_or_none(nextp(i)) is None and fp(curv) == phase_value(i, "next_fp"):
                atomic_write(nextp(i), curv, "cp_keepnew")
        except SystemExit:
            pass
    atomic_write(LIVE, pv, "cp_restore")
    kill_at("cp_after_restore")
    ok, msg = render_and_reload()
    if not ok:
        return False, "restored the file but %s" % msg
    ok, msg = config_matches(pf)
    if not ok:
        return False, "restored the file but " + msg
    return True, pf


def do_promote(args):
    i = need_id(args)
    if not args.backend_already_restarted:
        die("REFUSED: promote requires --backend-already-restarted (the Backend must hold the NEW secret first; rotate-webhook-secret.sh orders this)")
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp == "finalized":
        say("already finalized: id=%s (nothing changed)" % i)
        return 0
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back; start a new rotation with a new id" % i)
    if lp is None:
        die("REFUSED: no rotation with id %s (run prepare first)" % i)
    new_fp = phase_value(i, "next_fp")
    old_fp = phase_value(i, "old_fp")
    if not new_fp:
        die("REFUSED: the journal of %s has no prepared fingerprint" % i)
    v, lf = live_state()
    if lp == "promoted":
        ok, msg = config_matches(new_fp)
        if lf == new_fp and ok:
            say("already promoted: id=%s live and rendered fp=%s (nothing changed)" % (i, new_fp))
            return 0
    if lstat_or_none(nextp(i)) is not None:
        nv = read_secret(nextp(i), "the prepared secret")
        if fp(nv) != new_fp:
            die("REFUSED: the prepared secret file does not match the journal (fp %s, journal %s)" % (fp(nv), new_fp))
        if lf == new_fp:
            die("REFUSED: the live secret already equals the prepared one but the prepared file is still present: investigate (status)")
        if file_problems(LIVE) or file_problems(nextp(i)):
            die("REFUSED: secret file mode/owner: %s" % ", ".join(file_problems(LIVE) + file_problems(nextp(i))))
        append_state(i, "promote-begin", old_fp=lf, next_fp=new_fp)
        pv_path = prevp(i)
        if lstat_or_none(pv_path) is not None:
            if fp(read_secret(pv_path, "the preserved previous secret")) != lf:
                die("REFUSED: %s exists and differs from the live secret: inconsistent, investigate (status)" % "the .prev file")
        else:
            atomic_write(pv_path, v, "cp_prev")
        kill_at("cp_after_prev")
        os.replace(nextp(i), LIVE)
        fsync_dir(SECDIR)
        kill_at("cp_after_rename")
    else:
        # resume: the rename already happened (killed before the render finished) -> live must hold the new secret and the previous one must be preserved
        if not (lf == new_fp and lstat_or_none(prevp(i)) is not None):
            die("REFUSED: no prepared secret for id %s and the live secret is not the promoted one (status)" % i)
        append_state(i, "promote-begin", old_fp=old_fp or "unknown", next_fp=new_fp, resumed="yes")
    ok, msg = render_and_reload()
    if ok:
        ok, msg = config_matches(new_fp)
    if not ok:
        say("PROMOTE FAILED: %s" % msg)
        say("restoring the previous secret automatically...")
        rok, rmsg = restore_prev(i, msg)
        if rok:
            append_state(i, "promote-failed", restored="yes", live_fp=rmsg, reason="render_or_reload_or_verify")
            audit("promote", i, "promote-failed-restored", old_fp=rmsg, next_fp=new_fp)
            say("PROMOTE FAILED AND RESTORED: the Control Plane holds the PREVIOUS secret again (fp %s). The Backend already holds the NEW one: nothing delivers until the Control Plane is promoted again." % rmsg)
            say("NEXT: `rotate-webhook-secret.sh resume --id %s` (retry) or `rollback --id %s` (put the Backend back too)." % (i, i))
            return 1
        append_state(i, "promote-failed", restored="NO", reason=rmsg)
        audit("promote", i, "promote-failed-RESTORE-FAILED", next_fp=new_fp)
        say("CRITICAL: the automatic restore FAILED: %s" % rmsg)
        say("STATE UNKNOWN: the live secret file is the PREVIOUS one if the restore wrote it; the preserved copy is %s. Do NOT retry blindly: run `status --id %s`." % ("/etc/aicc/secrets/entitlement-webhook.secret.prev-" + i, i))
        return 3
    append_state(i, "promoted", live_fp=new_fp, old_fp=old_fp or "unknown")
    audit("promote", i, "promoted", next_fp=new_fp, old_fp=old_fp or "unknown")
    say("promoted: id=%s live and rendered fp=%s; php-fpm reloaded; previous secret preserved as .prev-%s (fp %s)" % (i, new_fp, i, old_fp))
    return 0


def do_probe_new(args):
    url = backend_url(args)
    v, lf = live_state()
    cmd = ["aicc-wp", "eval-file", PROBE_PHP] + ([url] if args.backend_url else [])
    rc, txt = run(cmd, 120)
    kv = dict(re.findall(r"(?m)^(status|error|constant_fp)=([A-Za-z0-9_]{1,64})\s*$", txt))
    if "status" not in kv:
        say("probe-new: FAIL the probe did not run (exit %d): %s" % (rc, " | ".join(txt.splitlines()[-2:])[:200]))
        return 1
    if kv.get("constant_fp") != lf:
        say("probe-new: FAIL the RUNNING constant (fp %s) differs from the live secret file (fp %s)" % (kv.get("constant_fp"), lf))
        return 1
    if kv["status"] == "400" and kv.get("error") == "webhook_payload_malformed":
        say("probe-new: PASS status=400 error=webhook_payload_malformed constant_fp=%s (the Backend accepted the Control Plane's signature)" % lf)
        return 0
    say("probe-new: FAIL status=%s error=%s constant_fp=%s (expected 400 webhook_payload_malformed)" % (kv["status"], kv.get("error"), lf))
    return 1


def do_probe_old(args):
    i = need_id(args)
    url = backend_url(args)
    path = prevp(i) if lstat_or_none(prevp(i)) is not None else retiredp(i)
    if lstat_or_none(path) is None:
        die("REFUSED: no preserved previous secret for id %s" % i)
    v = read_secret(path, "the preserved previous secret")
    want = phase_value(i, "old_fp")
    if want and fp(v) != want:
        say("probe-old: FAIL the preserved previous secret (fp %s) is not the one the journal recorded (fp %s): the probe would prove nothing" % (fp(v), want))
        return 1
    status, err, note = post_probe(url, v)
    if status == 401 and err == "webhook_signature_invalid":
        say("probe-old: PASS status=401 error=webhook_signature_invalid (the Backend rejects the previous secret, fp %s)" % fp(v))
        return 0
    if status == 400:
        say("probe-old: FAIL status=400: THE BACKEND STILL ACCEPTS THE PREVIOUS (EXPOSED) SECRET (fp %s)" % fp(v))
        return 1
    say("probe-old: FAIL status=%s error=%s %s(expected 401 webhook_signature_invalid)" % (status, err, ("(" + note + ") ") if note else ""))
    return 1


def do_fingerprint(args):
    which = args.which or "live"
    if which == "live":
        path = LIVE
    elif which == "config":
        f, note = config_fp()
        if f is None:
            die(note)
        say(f)
        return 0
    elif which in ("next", "prev", "retired"):
        i = need_id(args)
        path = {"next": nextp, "prev": prevp, "retired": retiredp}[which](i)
        if lstat_or_none(path) is None:
            die("absent: %s file of id %s" % (which, i))
    else:
        die("REFUSED: --which must be live, next, prev, retired or config")
    say(fp(read_secret(path, "the %s secret file" % which)))
    return 0


def do_rollback(args):
    i = need_id(args)
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp is None:
        die("REFUSED: no rotation with id %s" % i)
    listed = any(e[2] == i for e in registry_entries())
    if lp == "finalized" or listed:
        if not args.i_reinstate_a_retired_secret:
            die("REFUSED: id %s is %s: its previous secret is RETIRED (it was exposed). Rolling back would put an exposed secret back. If you really must, a manual decision with --i-reinstate-a-retired-secret; `verify` will keep failing RETIRED_SECRET_IN_USE until a new rotation." % (i, "FINALIZED" if lp == "finalized" else "listed in the retired registry (a finalize was interrupted)"))
        src_ = retiredp(i) if lstat_or_none(retiredp(i)) is not None else prevp(i)
        rv = read_secret(src_, "the retired secret of this id")
        try:
            curv = read_secret(LIVE, "the live secret file")
            if curv != rv and lstat_or_none(nextp(i)) is None:
                atomic_write(nextp(i), curv, "cp_keepnew")        # the new secret is kept (as .next-ID) before the live file is overwritten
        except SystemExit:
            pass
        atomic_write(LIVE, rv, "cp_reinstate")
        ok, msg = render_and_reload()
        if ok:
            ok, msg = config_matches(fp(rv))
        append_state(i, "reinstated", live_fp=fp(rv), ok="yes" if ok else "NO")
        audit("reinstate", i, "reinstated", old_fp=fp(rv))
        say("WARNING: A RETIRED SECRET (fp %s) WAS REINSTATED ON THE CONTROL PLANE BY YOUR EXPLICIT DECISION. IT IS EXPOSED. `verify` WILL FAIL RETIRED_SECRET_IN_USE UNTIL A NEW ROTATION. The registry was not changed." % fp(rv))
        if not ok:
            say("CRITICAL: render/reload/verify failed after the reinstatement: %s" % msg)
            return 3
        return 0
    if lp == "rolled-back":
        say("already rolled back: id=%s (nothing changed)" % i)
        return 0
    if lp == "prepared":
        append_state(i, "rolled-back", live_changed="no")
        audit("rollback", i, "rolled-back")
        say("rolled back: id=%s was only prepared; the live secret was never changed. The unused prepared secret stays as .next-%s (never deleted; root 0600)." % (i, i))
        return 0
    # promote-begin / promoted / promote-failed: the previous secret must be live AND rendered
    if lstat_or_none(prevp(i)) is None:
        v, lf = live_state()
        if lf == phase_value(i, "old_fp") and config_matches(lf)[0]:
            append_state(i, "rolled-back", live_changed="no")
            say("rolled back: the live secret is still the previous one (the promote never reached the rename)")
            return 0
        die("CRITICAL: no preserved previous secret (.prev-%s) and the live secret is not the previous one: STATE UNKNOWN, run status" % i, 3)
    pv = read_secret(prevp(i), "the preserved previous secret")
    pf = fp(pv)
    v, lf = live_state()
    cfp, _ = config_fp()
    if lf == pf and cfp == pf:
        say("the previous secret is already live and rendered (nothing to restore)")
    else:
        rok, rmsg = restore_prev(i, "rollback")
        if not rok:
            say("CRITICAL: the rollback could not restore the Control Plane: %s" % rmsg)
            say("STATE UNKNOWN: the preserved previous secret is %s; run `status --id %s`." % ("/etc/aicc/secrets/entitlement-webhook.secret.prev-" + i, i))
            return 3
    append_state(i, "rolled-back", live_fp=pf, live_changed="restored")
    audit("rollback", i, "rolled-back", old_fp=pf)
    say("ROLLED BACK ON THE CONTROL PLANE: THE PREVIOUS SECRET (fp %s) -- THE EXPOSED ONE -- IS BACK IN SERVICE. THE ROTATION MUST BE RE-RUN." % pf)
    return 0


def do_finalize(args):
    i = need_id(args)
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp is None:
        die("REFUSED: no rotation with id %s" % i)
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back" % i)
    new_fp = phase_value(i, "next_fp")
    old_fp = phase_value(i, "old_fp")
    if lp != "finalized":
        if lp != "promoted":
            die("REFUSED: id %s is in phase %s, not promoted (finalize only after a successful promote)" % (i, lp))
        v, lf = live_state()
        ok, msg = config_matches(new_fp)
        if lf != new_fp or not ok:
            die("REFUSED: the live/rendered secret is not the promoted one (%s)" % (msg or "live fp differs"))
    if not old_fp or not re.fullmatch(r"[0-9a-f]{16}", old_fp):
        die("REFUSED: the journal has no previous fingerprint for %s" % i)
    if lp != "finalized":
        state_, d_ = drain_state(i)
        if state_ != "ok":
            die("REFUSED: the outbox is not drained (%s %s): the old secret is NOT retired (events sent in the mismatch window may still be waiting)" % (state_, " ".join("%s=%s" % kv for kv in sorted(d_.items()) if kv[0] != "exhausted_ids")))
        # the journal line FIRST: from here on a rollback is refused on both the journal and the registry, so there is no window in which the registry lists the secret while the journal still allows a rollback
        append_state(i, "finalized", retired_fp=old_fp, live_fp=new_fp)
        audit("finalize", i, "finalized", old_fp=old_fp, next_fp=new_fp)
    added = registry_add(old_fp, i)
    kill_at("cp_after_registry")
    pp, rp = prevp(i), retiredp(i)
    if lstat_or_none(pp) is not None:
        if lstat_or_none(rp) is not None:
            die("REFUSED: both .prev-%s and .retired-%s exist (nothing is overwritten): investigate" % (i, i))
        os.rename(pp, rp)
        fsync_dir(SECDIR)
    elif lstat_or_none(rp) is None:
        die("CRITICAL: neither .prev-%s nor .retired-%s exists: the previous secret file is missing" % (i, i), 3)
    say("finalized: id=%s previous secret fp=%s is RETIRED (registry %s); kept as .retired-%s (root 0600, never deleted). Registry now holds %d entr%s." % (
        i, old_fp, "updated" if added else "already had it", i, len(registry_entries()), "y" if len(registry_entries()) == 1 else "ies"))
    return 0


def do_outbox_events(args):
    snap = snapshot()
    if snap is None:
        say("FAIL: the pending outbox events could not be listed")
        return 1
    say("OUTBOX_EVENTS pending=%d exhausted=%d at_or_above_%d_attempts=%d" % (len(snap["pending"]), len(snap["exhausted"]), ATTEMPT_REFUSE, sum(1 for n in snap["pending"].values() if n >= ATTEMPT_REFUSE)))
    return 0


def do_drain_check(args):
    i = need_id(args)
    st, d = drain_state(i)
    if st in ("nobaseline", "unreadable"):
        say("DRAIN state=%s (%s)" % (st, "no baseline snapshot of the pending events was recorded for this id" if st == "nobaseline" else "the pending events could not be listed"))
        return 4
    say("DRAIN state=%s new_pending=%d exhausted=%d baseline_still_pending=%d baseline_retried=%d" % (st, d["new_pending"], d["exhausted"], d["baseline_still_pending"], d["baseline_retried"]))
    for k in d["exhausted_ids"][:20]:
        say("EXHAUSTED_EVENT %s" % k)
    return {"ok": 0, "waiting": 1, "exhausted": 2}[st]


def do_registry_check(args):
    i = need_id(args)
    say("REGISTRY id=%s listed=%s" % (i, "yes" if any(e[2] == i for e in registry_entries()) else "no"))
    return 0


MODES = {"status": do_status, "preflight": do_preflight, "outbox": do_outbox, "prepare": do_prepare, "emit-next": do_emit_next, "promote": do_promote, "probe-new": do_probe_new,
         "probe-old": do_probe_old, "fingerprint": do_fingerprint, "rollback": do_rollback, "finalize": do_finalize, "outbox-events": do_outbox_events, "drain-check": do_drain_check,
         "registry-check": do_registry_check}
READONLY = ("status", "outbox", "fingerprint", "probe-new", "probe-old", "preflight")


def main():
    ap = argparse.ArgumentParser(prog=NAME, allow_abbrev=False, add_help=True, description="see the header of this file")
    ap.add_argument("mode", choices=sorted(MODES))
    ap.add_argument("--id")
    ap.add_argument("--expect-stage-id", dest="expect_stage_id")
    ap.add_argument("--which")
    ap.add_argument("--backend-url", dest="backend_url")
    ap.add_argument("--baseline-pending", type=int, dest="baseline_pending")
    ap.add_argument("--baseline-exhausted", type=int, dest="baseline_exhausted")
    ap.add_argument("--backend-already-restarted", action="store_true", dest="backend_already_restarted")
    ap.add_argument("--i-reinstate-a-retired-secret", action="store_true", dest="i_reinstate_a_retired_secret")
    ap.add_argument("--replace-retired-secret", action="store_true", dest="replace_retired_secret")
    args = ap.parse_args()
    if args.id is not None and not ID_RE.fullmatch(args.id):
        die("REFUSED: --id must look like 20261117T182030Z (UTC time of the rotation)", 2)
    if not HARNESS and os.geteuid() != 0:
        die("must run as root (sudo). Refusing.")
    check_identity(args.expect_stage_id, args.mode not in ("status", "fingerprint", "outbox", "probe-old"))
    return MODES[args.mode](args)


try:
    sys.exit(main())
except SystemExit:
    raise
except BaseException as e:      # never a traceback with local state: only the class of the problem
    sys.stderr.write("%s: internal error (%s)\n" % (NAME, type(e).__name__))
    sys.exit(1)
