#!/usr/bin/env python3
"""aicc-rotate-webhook-secret-api: the BACKEND half of the ENTITLEMENT_WEBHOOK_SECRET rotation. Runs ON THE API HOST as root (sudo). It is delivered to /usr/local/sbin by the owner's
infra/provision/rotate-webhook-secret.sh (`install-api-tool`, sha256 verified before and after: this host has no install-stack) and started over SSH by that script; it can also run from stdin
(`python3 -I - preflight < this-file`) for the read-only plan without installing anything. The secret is never printed, never in an argument, an environment variable, a log or the journal.

    sudo aicc-rotate-webhook-secret-api status      [--id ID] [--expect-hostname H]    env / staged / backup fingerprints, Backend health, bystander, registry (RETIRED_SECRET_IN_USE)
    sudo aicc-rotate-webhook-secret-api preflight   [--id ID] --expect-hostname H      read-only checks (with --id the baseline is recorded once in the journal)
    sudo aicc-rotate-webhook-secret-api stage       --id ID --expect-hostname H        the NEW secret on STDIN (exactly one line) -> /etc/aicc/webhook-rotation/ID/next.secret (0600 root, atomic); prints its fingerprint
    sudo aicc-rotate-webhook-secret-api apply       --id ID --expect-hostname H        backup of the COMPLETE env file, replace ONLY the ENTITLEMENT_WEBHOOK_SECRET line, restart aicc-backend, wait for the SAME build and mode;
                                                                                       ANY failure restores the env copy, restarts, waits for health, and fails loudly
    sudo aicc-rotate-webhook-secret-api probe-new   [--id ID]                          local non-mutating probe signed with the env's secret: PASS = 400 webhook_payload_malformed
    sudo aicc-rotate-webhook-secret-api probe-old   --id ID                            the previous secret (from the env copy) must be REJECTED: PASS = 401 webhook_signature_invalid
    sudo aicc-rotate-webhook-secret-api fingerprint [--which env|staged|backup] [--id ID]
    sudo aicc-rotate-webhook-secret-api rollback    --id ID --expect-hostname H [--i-reinstate-a-retired-secret]
    sudo aicc-rotate-webhook-secret-api finalize    --id ID --expect-hostname H

FILES: /etc/aicc/backend.env (640 root:aicc: only the one ENTITLEMENT_WEBHOOK_SECRET line is ever changed), /etc/aicc/backend.env.pre-webhook-rotation-ID (the complete copy, `cp -p` semantics: bytes, mode, owner, mtime;
KEPT FOREVER: this tool never deletes a backup or a staged secret), /etc/aicc/webhook-rotation/ID/next.secret (0600 root), /var/lib/aicc/webhook-rotation/ID.state + .lock (as on the Control Plane),
/etc/aicc/webhook-secret-retired.fp (retired fingerprints; `status` fails RETIRED_SECRET_IN_USE when the env's secret is in it). Audit: `logger -t aicc-webhook-rotate` (action, id, phase, fingerprint PREFIXES).
THE BYSTANDER: the container `nourishvik-care` shares this host; it is only READ (docker inspect): a rotation refuses to start when it is not healthy and reports its StartedAt before and after.
TEST SEAMS (ONLY with AICC_TEST_HARNESS=1 and an AICC_ROOT_PREFIX directory under the system temp dir; loud banner): AICC_ROOT_PREFIX, AICC_TEST_KILL_AT, AICC_TEST_BACKEND_URL (a local fake Backend),
AICC_TEST_HOSTNAME, AICC_TEST_NO_FSYNC=1 (skips fsync, slow fixture volume), AICC_TEST_SHORT_WRITE=1, the owner is the calling user.
"""
import os
import sys

if not sys.flags.isolated and "__file__" in globals():     # the isolated-mode re-exec comes BEFORE any other import: nothing from the caller's directory or environment can be imported first
    os.execv(sys.executable, [sys.executable, "-I", os.path.abspath(__file__)] + sys.argv[1:])

import argparse
import ctypes
import fcntl
import grp
import hashlib
import hmac
import json
import re
import resource
import signal
import socket
import stat
import subprocess
import time
import urllib.error
import urllib.request

NAME = "aicc-rotate-webhook-secret-api"
FP_TAG = b"aicc-webhook-secret-fingerprint-v1\n"
SIGN_TAG = b"aicc-entitlement-webhook-v1\n"
PROBE_BODY = b'{"probe":"aicc-webhook-rotation"}'
ENV_KEY = b"ENTITLEMENT_WEBHOOK_SECRET="
UNIT = "aicc-backend"
ID_RE = re.compile(r"[0-9]{8}T[0-9]{6}Z")
SECRET_RE = re.compile(rb"[A-Za-z0-9._~+/=-]{32,}")
HEX64_RE = re.compile(rb"[0-9a-f]{64}")
PHASES = ("staged", "apply-begin", "applied", "apply-failed", "rolled-back", "finalized")
TERMINAL = ("rolled-back", "finalized")
HARNESS = os.environ.get("AICC_TEST_HARNESS") == "1"
PREFIX = ""


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (NAME, msg))
    sys.exit(code)


def say(msg=""):
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


HARNESS_ROOTS = ("/tmp", "/var/tmp", "/private/tmp", "/private/var/folders")      # fixed allow-list: $TMPDIR is NEVER consulted
HARNESS_SENTINEL = ".aicc-test-harness-root"


def harness_gate(p):
    """The test seams re-root every path, so they are refused unless the prefix is an unmistakable scratch directory: an absolute CANONICAL path (no symlinked or relative component, not /), strictly below the fixed
    temp allow-list, carrying the sentinel file the fixture creates, never when running as root under sudo. Returns the prefix or dies."""
    why = "AICC_TEST_HARNESS=1 needs AICC_ROOT_PREFIX to be an existing directory under the system temp dir (the seams are for tests only)"
    if not p or not os.path.isabs(p) or p != os.path.normpath(p):
        die("REFUSED: %s [not an absolute normalised path]" % why)
    if not os.path.isdir(p) or os.path.realpath(p) != p or p == "/":
        die("REFUSED: %s [not an existing canonical directory: a symlinked component or / is refused]" % why)
    if not any(p.startswith(r + "/") for r in HARNESS_ROOTS):
        die("REFUSED: %s [outside %s]" % (why, ", ".join(HARNESS_ROOTS)))
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        die("REFUSED: the test seams are never honoured by root running under sudo (SUDO_USER is set)")
    st = None
    try:
        st = os.lstat(os.path.join(p, HARNESS_SENTINEL))
    except OSError:
        pass
    if st is None or not stat.S_ISREG(st.st_mode):
        die("REFUSED: %s [the prefix has no %s sentinel file]" % (why, HARNESS_SENTINEL))
    return p


def harden_process():
    """No core dump and not dumpable (best effort): a crash must not write the secret into a core file or let a same-user process read /proc/<pid>/mem."""
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except Exception:
        pass
    try:
        ctypes.CDLL(None).prctl(4, 0, 0, 0, 0)      # PR_SET_DUMPABLE = 4
    except Exception:
        pass


harden_process()
if HARNESS:
    PREFIX = harness_gate(os.environ.get("AICC_ROOT_PREFIX", ""))
    sys.stderr.write("%s: *** TEST HARNESS ACTIVE: paths re-rooted under %s, owner/kill/backend/hostname seams honoured. Never set this on a real host. ***\n" % (NAME, PREFIX))
else:
    os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def P(path):
    return PREFIX + path


ENVF = P("/etc/aicc/backend.env")
ROTROOT = P("/etc/aicc/webhook-rotation")
STATEDIR = P("/var/lib/aicc/webhook-rotation")
LOCKF = STATEDIR + "/.lock"
REGISTRY = P("/etc/aicc/webhook-secret-retired.fp")
BYSTANDER_DEFAULT = "nourishvik-care"
ENV_LOCK = P("/etc/aicc/.backend.env.lock")       # flock taken by `apply` / `rollback` around every write of backend.env: other deploy tooling that writes the file can take the same lock
SUDOERS_FILES = (P("/etc/sudoers"), P("/etc/sudoers.d"))
BACKEND_BASE = "http://127.0.0.1:8000"
if HARNESS and os.environ.get("AICC_TEST_BACKEND_URL"):
    if not re.fullmatch(r"http://127\.0\.0\.1:[0-9]{2,5}", os.environ["AICC_TEST_BACKEND_URL"]):
        die("REFUSED: AICC_TEST_BACKEND_URL must be http://127.0.0.1:<port>")
    BACKEND_BASE = os.environ["AICC_TEST_BACKEND_URL"]


def kill_at(stage):
    if HARNESS and os.environ.get("AICC_TEST_KILL_AT") == stage:
        os.kill(os.getpid(), signal.SIGKILL)


def pause(sec):
    time.sleep(min(sec, 0.2) if HARNESS else sec)


def utcnow():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def fp(secret):
    return hashlib.sha256(FP_TAG + secret).hexdigest()[:16]


def valid_secret(b):
    return SECRET_RE.fullmatch(b) is not None and len(set(b)) >= 12


_PATHISH = ("/etc/", "/var/", "/usr/", "/srv/", "/Users/", "/private/", "/tmp/", "/home/", "://")


def redact(text):
    """Mask anything that could be a secret in printed output (defence in depth: the tools never print one): a run of 41 or more characters of the FULL secret charset [A-Za-z0-9_.~+/=-] (an `=` only as trailing base64 padding, so `key=value` pairs and 40-hex build ids stay readable), except file paths and URLs."""
    return re.sub(r"[A-Za-z0-9_.~+/-]{41,}={0,2}", lambda m: m.group(0) if any(x in m.group(0) for x in _PATHISH) else "<long-token-hidden>", text)


def lstat_or_none(path):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        return None


def fsync(fd):
    """os.fsync, except in the test harness when AICC_TEST_NO_FSYNC=1 (the fixture's temp volume fsyncs slowly; a killed process never loses page-cache data, so the atomicity tests do not need it)."""
    if HARNESS and os.environ.get("AICC_TEST_NO_FSYNC") == "1":
        return
    os.fsync(fd)


def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        fsync(fd)
    finally:
        os.close(fd)


def root_ids():
    return (os.getuid(), os.getgid()) if HARNESS else (0, 0)


def env_ids():
    """(uid, gid) the env file must have: root:aicc on the host, the calling user in the harness."""
    if HARNESS:
        return os.getuid(), os.getgid()
    try:
        return 0, grp.getgrnam("aicc").gr_gid
    except KeyError:
        die("REFUSED: the group `aicc` does not exist on this host")


def atomic_write(path, data, tag, uid, gid, mode, mtime=None, xattr_from=None):
    """O_EXCL temp in the SAME directory (0400 until complete), short-write check, fchown/fchmod, fsync, rename over the target, fsync of the directory: a killed process leaves the old file or the new one."""
    d, base = os.path.dirname(path), os.path.basename(path)
    tmp = os.path.join(d, ".%s.new.%d" % (base, os.getpid()))
    old = os.umask(0o277)
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    finally:
        os.umask(old)
    try:
        kill_at(tag + "_after_create")
        chunk = data[:-3] if (HARNESS and os.environ.get("AICC_TEST_SHORT_WRITE") == "1") else data
        n = os.write(fd, chunk)
        if n != len(data) or os.fstat(fd).st_size != len(data):
            die("REFUSED: %s was not written completely (wrote %d of %d bytes); the existing file was NOT touched" % (base, n, len(data)))
        kill_at(tag + "_after_write")
        os.fchown(fd, uid, gid)
        os.fchmod(fd, mode)
        if mtime is not None:
            os.utime(fd, ns=mtime)
        if xattr_from is not None and hasattr(os, "listxattr"):
            try:
                for name in os.listxattr(xattr_from, follow_symlinks=False):
                    try:
                        os.setxattr(fd, name, os.getxattr(xattr_from, name, follow_symlinks=False))
                    except OSError:
                        pass
            except OSError:
                pass
        fsync(fd)
        kill_at(tag + "_after_fsync")
    except BaseException:
        os.close(fd)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.close(fd)
    os.replace(tmp, path)
    kill_at(tag + "_after_rename")
    fsync_dir(d)


def sweep_temps():
    for d in (os.path.dirname(ENVF), os.path.dirname(REGISTRY)):
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if re.fullmatch(r"\.(backend\.env[A-Za-z0-9.-]*|webhook-secret-retired\.fp)\.new\.[0-9]+", n):
                p = os.path.join(d, n)
                if stat.S_ISREG(os.lstat(p).st_mode):
                    os.unlink(p)
    for sub in (os.listdir(ROTROOT) if os.path.isdir(ROTROOT) else []):
        sd = os.path.join(ROTROOT, sub)
        for n in (os.listdir(sd) if os.path.isdir(sd) else []):
            if re.fullmatch(r"\.next\.secret\.new\.[0-9]+", n):
                os.unlink(os.path.join(sd, n))


# ---- state journal, lock, registry, audit ----------------------------------------------------------------------------------------------------------------------------------------------
def ensure_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def state_path(i):
    return os.path.join(STATEDIR, "%s.state" % i)


def state_lines(i):
    out = []
    try:
        with open(state_path(i), "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1].startswith("phase="):
                    out.append((parts[0], parts[1][6:], dict(p.split("=", 1) for p in parts[2:] if "=" in p)))
    except OSError:
        pass
    return out


def last_phase(i):
    ph = [p for (_, p, _) in state_lines(i) if p in PHASES]
    return ph[-1] if ph else None


def phase_value(i, key):
    for (_, p, kv) in reversed(state_lines(i)):
        if key in kv:
            return kv[key]
    return None


def append_state(i, phase, **kv):
    ensure_dir(STATEDIR)
    fields = " ".join("%s=%s" % (k, re.sub(r"[^A-Za-z0-9._:/,=+-]", "_", str(v))) for k, v in sorted(kv.items()))
    line = "%s phase=%s%s\n" % (utcnow(), phase, (" " + fields) if fields else "")
    fd = os.open(state_path(i), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, line.encode())
        fsync(fd)
    finally:
        os.close(fd)


def audit(action, i, phase, **fps):
    parts = ["action=%s" % action, "id=%s" % i, "phase=%s" % phase, "operator=%s" % os.environ.get("SUDO_USER", "root")]
    parts += ["%s_prefix=%s" % (k, str(v)[:8]) for k, v in sorted(fps.items())]
    try:
        subprocess.run(["logger", "-t", "aicc-webhook-rotate", "--", " ".join(parts)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def take_lock():
    ensure_dir(STATEDIR)
    fd = os.open(LOCKF, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("REFUSED: another %s is running (the rotation lock is held); wait for it, run `status`, then retry" % NAME)
    return fd


def unfinished_other(i):
    try:
        names = sorted(os.listdir(STATEDIR))
    except OSError:
        return None
    for n in names:
        m = re.fullmatch(r"([0-9]{8}T[0-9]{6}Z)\.state", n)
        if m and m.group(1) != i:
            lp = last_phase(m.group(1))
            if lp is not None and lp not in TERMINAL:
                return m.group(1), lp
    return None


def registry_entries():
    out = []
    try:
        with open(REGISTRY, "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and re.fullmatch(r"[0-9a-f]{16}", parts[0]):
                    out.append((parts[0], parts[1], parts[2]))
    except OSError:
        pass
    return out


def registry_add(old_fp, i):
    entries = registry_entries()
    if any(e[2] == i for e in entries):
        return False
    text = "".join("%s %s %s\n" % e for e in entries) + "%s %s %s\n" % (old_fp, utcnow(), i)
    u, g = root_ids()
    atomic_write(REGISTRY, text.encode(), "api_registry", u, g, 0o600)
    return True


# ---- subprocesses, health, bystander, probe ------------------------------------------------------------------------------------------------------------------------------------------
def run(cmd, timeout=120):
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    except FileNotFoundError:
        return 127, "%s: command not found" % cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "%s: timed out after %ds" % (cmd[0], timeout)
    return r.returncode, redact(r.stdout.decode("utf-8", "replace")).strip()


def get_health():
    """(dict|None, note). The Backend's own /health on the loopback."""
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(BACKEND_BASE + "/health", timeout=5) as r:
            body = r.read(8192)
        j = json.loads(body.decode("utf-8", "replace"))
        return (j if isinstance(j, dict) else None), ""
    except urllib.error.HTTPError as e:
        return None, "HTTP %d" % e.code
    except Exception as e:
        return None, type(e).__name__


def health_good(h):
    return bool(h) and h.get("status") == "ok" and h.get("database") == "connected" and isinstance(h.get("build"), str) and re.fullmatch(r"[0-9a-f]{40}", h["build"]) is not None \
        and isinstance(h.get("entitlement_mode"), str) and re.fullmatch(r"[a-z_]{1,32}", h["entitlement_mode"]) is not None


def wait_health(want_build, want_mode, timeout):
    """Poll /health until it is ok with the SAME build and entitlement_mode. Returns (ok, message)."""
    deadline = time.time() + timeout
    last = "no answer"
    while True:
        h, note = get_health()
        if health_good(h):
            if h["build"] == want_build and h["entitlement_mode"] == want_mode:
                return True, ""
            last = "health ok but build/mode changed (build %s, mode %s)" % (h["build"][:12], h["entitlement_mode"])
        else:
            last = "health not ok (%s)" % (note or ("status=%s database=%s" % (h.get("status"), h.get("database")) if h else "no JSON"))
        if time.time() >= deadline:
            return False, "%s after %ds" % (last, timeout)
        pause(1)


def bystander(name):
    """{'name','state','health','started_at','healthy'} read-only through docker inspect."""
    rc, txt = run(["docker", "inspect", "--format", "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.State.StartedAt}}", name], 30)
    m = re.fullmatch(r"([a-z]+)\|([a-z]+)\|([0-9T:.Z+-]+)", txt.strip()) if rc == 0 else None
    if not m:
        return {"name": name, "state": "unknown", "health": "unknown", "started_at": "unknown", "healthy": False}
    return {"name": name, "state": m.group(1), "health": m.group(2), "started_at": m.group(3), "healthy": m.group(1) == "running" and m.group(2) in ("healthy", "none")}


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


def error_code(body):
    code = None
    try:
        j = json.loads(body.decode("utf-8", "replace"))
        d = j.get("detail", j) if isinstance(j, dict) else None
        if isinstance(d, dict) and isinstance(d.get("error"), str):
            code = d["error"]
        elif isinstance(j, dict) and isinstance(j.get("error"), str):
            code = j["error"]
    except Exception:
        pass
    if code is None:
        m = re.search(rb"(webhook_[a-z_]+|entitlement_webhook_not_configured)", body)
        code = m.group(1).decode() if m else "none"
    return code if re.fullmatch(r"[a-z_]{1,64}", code) else "unrecognised"


def post_probe(secret):
    """The NON-MUTATING probe against the loopback Backend (see the Control Plane tool): 400 webhook_payload_malformed = the Backend holds this secret; 401 webhook_signature_invalid = it does not."""
    ts = int(time.time())
    sig = hmac.new(secret, SIGN_TAG + str(ts).encode() + b"\n" + PROBE_BODY, hashlib.sha256).hexdigest()
    req = urllib.request.Request(BACKEND_BASE + "/v1/internal/entitlement/webhook", data=PROBE_BODY, method="POST",
                                 headers={"Content-Type": "application/json", "X-AICC-Webhook-Timestamp": str(ts), "X-AICC-Webhook-Signature": sig, "User-Agent": "aicc-webhook-rotation-probe/1"})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect)
    try:
        resp = opener.open(req, timeout=15)
        return resp.status, error_code(resp.read(4096))
    except urllib.error.HTTPError as e:
        return e.code, error_code(e.read(4096))
    except Exception as e:
        return None, type(e).__name__


# ---- the env file ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
def parse_env(data):
    """(line index, value bytes, problems). EXACTLY ONE line may mention ENTITLEMENT_WEBHOOK_SECRET and it must be the plain assignment of a 64-hex value."""
    problems = []
    lines = data.split(b"\n")
    mentions = [k for k, l in enumerate(lines) if b"ENTITLEMENT_WEBHOOK_SECRET" in l]
    assigns = [k for k in mentions if lines[k].startswith(ENV_KEY)]
    if len(mentions) != 1 or len(assigns) != 1:
        problems.append("expected exactly ONE line naming ENTITLEMENT_WEBHOOK_SECRET and it must be the plain `ENTITLEMENT_WEBHOOK_SECRET=<64 hex>` assignment (found %d mention(s), %d assignment(s))" % (len(mentions), len(assigns)))
        return None, None, problems
    if b"\r" in data:
        problems.append("the env file contains a carriage return (CRLF): refused")
    k = assigns[0]
    val = lines[k][len(ENV_KEY):]
    if not HEX64_RE.fullmatch(val):
        problems.append("the current ENTITLEMENT_WEBHOOK_SECRET value is not 64 lowercase hex characters")
    return k, val, problems


def env_file_problems(path, backup=False):
    st = lstat_or_none(path)
    if st is None:
        return ["missing"]
    if not stat.S_ISREG(st.st_mode):
        return ["not a regular file (a symbolic link is never used)"]
    out = []
    uid, gid = env_ids()
    if st.st_uid != uid or st.st_gid != gid:
        out.append("owner is not root:aicc")
    if stat.S_IMODE(st.st_mode) != 0o640:
        out.append("mode is %04o, expected 0640" % stat.S_IMODE(st.st_mode))
    return out


def read_env(path=None):
    path = path or ENVF
    with open(path, "rb") as f:
        return f.read()


def mask(data, k):
    lines = data.split(b"\n")
    lines[k] = ENV_KEY + b"<MASKED>"
    return b"\n".join(lines)


def backup_path(i):
    return "%s.pre-webhook-rotation-%s" % (ENVF, i)


def staged_path(i):
    return os.path.join(ROTROOT, i, "next.secret")


def read_staged(i):
    st = lstat_or_none(staged_path(i))
    if st is None:
        die("REFUSED: no staged secret for id %s (run stage first)" % i)
    if not stat.S_ISREG(st.st_mode):
        die("REFUSED: the staged secret is not a regular file")
    with open(staged_path(i), "rb") as f:
        v = f.read(300).strip()
    if not HEX64_RE.fullmatch(v) or not valid_secret(v):
        die("REFUSED: the staged secret is not a valid 64-hex secret")
    return v


def env_value(path=None):
    data = read_env(path)
    k, val, problems = parse_env(data)
    if problems:
        die("REFUSED: %s: %s" % (os.path.basename(path or ENVF), "; ".join(problems)))
    return val


def make_backup(i):
    """`cp -p` of the COMPLETE env file: exact bytes, mode, owner and mtime, written to a temp file and renamed (never a partial backup). Never overwrites a backup."""
    bk = backup_path(i)
    data = read_env()
    st = os.lstat(ENVF)
    if lstat_or_none(bk) is not None:
        if env_value(bk) == env_value():
            return False       # the same, intact backup already exists
        return None            # a backup of another state exists: the caller decides
    atomic_write(bk, data, "api_backup", st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), mtime=(st.st_atime_ns, st.st_mtime_ns))
    return True


def restore_env(i, health_timeout):
    """Put the env copy back (bytes, mode, owner of the copy), restart, wait for health with the baseline build/mode, confirm the OLD secret is accepted. (ok, message)."""
    bk = backup_path(i)
    if lstat_or_none(bk) is None:
        return False, "no env copy %s to restore" % os.path.basename(bk)
    st = os.lstat(bk)
    data = read_env(bk)
    atomic_write(ENVF, data, "api_restore", st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), xattr_from=ENVF)
    kill_at("api_after_restore")
    rc, txt = run(["systemctl", "restart", UNIT], 60)
    if rc != 0:
        return False, "the env file is restored but `systemctl restart %s` failed (exit %d): %s" % (UNIT, rc, txt.splitlines()[-1] if txt else "no output")
    ok, msg = wait_health(baseline_values(i)[0] or "", baseline_values(i)[1] or "", health_timeout)
    if not ok:
        return False, "the env file is restored and the unit restarted but " + msg
    status, err = post_probe(env_value(bk))
    if status != 400 or err != "webhook_payload_malformed":
        return False, "the env file is restored but the Backend does not accept the previous secret (probe %s %s)" % (status, err)
    return True, fp(env_value(bk))


