def env_xattrs():
    """Extended attributes of backend.env (a POSIX ACL, an SELinux label, ...): the atomic replacement copies them best effort; the preflight WARNS when any exist."""
    if HARNESS and os.environ.get("AICC_TEST_FAKE_XATTR"):
        return os.environ["AICC_TEST_FAKE_XATTR"].split(",")
    try:
        return list(os.listxattr(ENVF, follow_symlinks=False))
    except (AttributeError, OSError):
        return []


def sudo_logging_warnings():
    """sudo I/O logging records the output (log_output) and input (log_input) of the commands it runs: the new secret is read from stdin by `stage`. Parses /etc/sudoers and what it includes
    (@include, @includedir, #include, #includedir) like sudo does for these settings: line continuations, `Defaults[:@!>]scope` lines split on commas, `!flag` negation with the LAST setting winning, and the LOG_INPUT: / LOG_OUTPUT: tags of rule lines.
    Returns [(file, what)]. NOT covered: /etc/sudo.conf plugins and auditd (the owner checklist names them). WARN only."""
    seen = set()
    state = {"log_output": None, "log_input": None, "iolog": None}
    hits = []

    def read(path, depth):
        if depth > 8:
            return
        rp = os.path.realpath(path)
        if rp in seen or not os.path.isfile(rp):
            return
        seen.add(rp)
        try:
            with open(rp, "r", errors="replace") as fh:
                lines = fh.read().split("\n")
        except OSError:
            return
        logical, cur = [], ""
        for ln in lines:
            if ln.endswith("\\"):
                cur += ln[:-1] + " "
                continue
            logical.append(cur + ln)
            cur = ""
        base = os.path.basename(rp)
        for raw in logical:
            line = raw.strip()
            m = re.match(r"^[@#](include|includedir)\s+(\S+)", line)
            if m:
                target = m.group(2).strip('"')
                target = P(target) if target.startswith("/") else os.path.join(os.path.dirname(rp), target)
                if m.group(1) == "include":
                    read(target, depth + 1)
                elif os.path.isdir(target):
                    for n in sorted(os.listdir(target)):
                        if "." not in n and not n.endswith("~"):
                            read(os.path.join(target, n), depth + 1)
                continue
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            m = re.match(r"^Defaults(?:[:@!>]\S+)?\s+(.*)$", line)
            if m:
                scoped = not re.match(r"^Defaults\s", line)
                for tok in m.group(1).split(","):
                    tok = tok.strip()
                    neg = tok.startswith("!")
                    name = tok.lstrip("!").split("=", 1)[0].strip()
                    if name in ("log_output", "log_input"):
                        if scoped:
                            if not neg:
                                hits.append((base, "Defaults (scoped) " + name))
                        else:
                            state[name] = None if neg else (base, "Defaults " + name)
                    elif name in ("iolog_dir", "iolog_file") and "=" in tok and not neg:
                        state["iolog"] = (base, "Defaults " + name)
                continue
            for t in re.findall(r"\b(NO)?LOG_(INPUT|OUTPUT):", line):
                if not t[0]:
                    hits.append((base, "rule tag LOG_" + t[1]))

    for start in (SUDOERS_FILES[0],):
        read(start, 0)
    d = SUDOERS_FILES[1]
    if os.path.isdir(d):
        for n in sorted(os.listdir(d)):
            if "." not in n and not n.endswith("~"):
                read(os.path.join(d, n), 0)
    return hits + [v for v in state.values() if v]


def take_env_lock():
    """Non-blocking exclusive flock around every write of backend.env (held until the process exits)."""
    fd = os.open(ENV_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("REFUSED: another process holds %s (a concurrent writer of backend.env?): nothing was changed" % "/etc/aicc/.backend.env.lock")
    return fd


def need_id(args):
    if not args.id or not ID_RE.fullmatch(args.id):
        die("REFUSED: --id must look like 20261117T182030Z (UTC time of the rotation)")
    return args.id


def check_host(args, required):
    if not required and not args.expect_hostname:
        return
    if required and not args.expect_hostname:
        die("REFUSED: --expect-hostname is required for this mode")
    have = os.environ.get("AICC_TEST_HOSTNAME") if HARNESS and os.environ.get("AICC_TEST_HOSTNAME") else socket.gethostname()
    if have != args.expect_hostname:
        die("REFUSED: this host is `%s`, not `%s` (wrong machine?)" % (have, args.expect_hostname))


def baseline(i):
    """The key=value pairs of the FIRST `baseline` line of the journal (taken before anything changed): build, mode, bystander StartedAt/state."""
    for (_, p, kv) in state_lines(i):
        if p == "baseline":
            return kv
    return {}


def baseline_values(i):
    b = baseline(i)
    return b.get("baseline_build"), b.get("baseline_mode")


def observe_lines(bname):
