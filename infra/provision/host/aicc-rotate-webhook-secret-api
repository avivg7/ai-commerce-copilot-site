    else:
        say("HEALTH status=NOT_OK note=%s" % (note or "unexpected body"))
    b = bystander(bname)
    say("BYSTANDER name=%s state=%s health=%s started_at=%s" % (b["name"], b["state"], b["health"], b["started_at"]))
    return h, b


def do_status(args):
    problems = 0
    env_fp = None
    pr = env_file_problems(ENVF)
    if pr:
        say("env: PROBLEM %s" % ", ".join(pr))
        problems += 1
    try:
        k, val, pp = parse_env(read_env())
        if pp:
            say("env: PROBLEM %s" % "; ".join(pp))
            problems += 1
        if val is not None and HEX64_RE.fullmatch(val):
            env_fp = fp(val)
            say("env: fp=%s file=/etc/aicc/backend.env %s" % (env_fp, "mode/owner ok" if not pr else "FILE PROBLEM"))
    except OSError:
        say("env: UNREADABLE")
        problems += 1
    h, b = observe_lines(args.bystander)
    if not health_good(h):
        problems += 1
    reg = registry_entries()
    say("registry: %d retired fingerprint(s)" % len(reg))
    if env_fp is not None and any(e[0] == env_fp for e in reg):
        say("RETIRED_SECRET_IN_USE: the Backend's env file holds a RETIRED secret (an old backup was restored?): it must not be used. Run a new rotation.")
        problems += 1
    ids = sorted(m.group(1) for m in (re.fullmatch(r"([0-9]{8}T[0-9]{6}Z)\.state", n) for n in (os.listdir(STATEDIR) if os.path.isdir(STATEDIR) else [])) if m)
    for rid in ids:
        lp = last_phase(rid)
        if lp not in TERMINAL:
            say("UNFINISHED id=%s phase=%s" % (rid, lp))
    if args.id:
        if last_phase(args.id) is not None:
            say("rotation: id=%s phase=%s" % (args.id, last_phase(args.id)))
        for (t, p, kv) in state_lines(args.id):
            say("journal %s phase=%s %s" % (t, p, " ".join("%s=%s" % x for x in sorted(kv.items()))))
        bb, bm = baseline_values(args.id)
        if bb:
            say("BASELINE build=%s mode=%s bystander_started_at=%s bystander_state=%s" % (bb, bm, baseline(args.id).get("bystander_started_at"), baseline(args.id).get("bystander_state")))
        if lstat_or_none(staged_path(args.id)) is not None:
            try:
                say("staged: fp=%s" % fp(read_staged(args.id)))
            except SystemExit:
                say("staged: present but UNUSABLE")
        if lstat_or_none(backup_path(args.id)) is not None:
            try:
                say("backup: fp=%s file=%s" % (fp(env_value(backup_path(args.id))), "/etc/aicc/backend.env.pre-webhook-rotation-" + args.id))
            except SystemExit:
                say("backup: present but UNUSABLE")
    return 3 if problems else 0


def do_preflight(args):
    fails = []

    def ok(m):
        say("ok: " + m)

    def fail(m):
        say("FAIL: " + m)
        fails.append(m)
    ok("host name verified: %s" % args.expect_hostname)
    env_fp = None
    pr = env_file_problems(ENVF)
    if pr:
        fail("/etc/aicc/backend.env: " + ", ".join(pr))
    else:
        ok("/etc/aicc/backend.env is a regular file, 640 root:aicc")
    try:
        k, val, pp = parse_env(read_env())
        if pp:
            for x in pp:
                fail("/etc/aicc/backend.env: " + x)
        else:
            env_fp = fp(val)
            ok("exactly one ENTITLEMENT_WEBHOOK_SECRET line, 64 hex, fp=%s" % env_fp)
    except OSError:
        fail("/etc/aicc/backend.env cannot be read")
    if env_fp is not None and any(e[0] == env_fp for e in registry_entries()):
        if args.replace_retired_secret:
            say("WARNING: the env's secret (fp %s) is a RETIRED one (an old backup was restored?). --replace-retired-secret: this rotation replaces it; it is exposed until the cutover is done." % env_fp)
            ok("the env's secret is in the retired registry and --replace-retired-secret was given: the rotation is the cure")
        else:
            fail("RETIRED_SECRET_IN_USE: the env's secret is a retired one: re-run with --replace-retired-secret (a rotation replaces it; the NEW secret is still refused if it is retired)")
    other = unfinished_other(args.id or "")
    if other:
        fail("an earlier rotation is unfinished: id=%s phase=%s (resume it or roll it back first)" % other)
    else:
        ok("no unfinished rotation")
    xa = env_xattrs()
    if xa:
        say("WARN: /etc/aicc/backend.env carries extended attributes / an ACL / an SELinux label (%s). The atomic replacement copies them best effort; check them after the rotation (`getfacl`, `ls -Z`)." % ", ".join(sorted(xa)))
    for f, what in sudo_logging_warnings():
        say("WARN: sudo I/O logging (log_output / log_input / iolog) is configured in sudoers file `%s` (%s): `stage` reads the secret from stdin through sudo; a root-only I/O log would hold it. Remove the setting for this tool or accept it knowingly. (/etc/sudo.conf plugins and auditd are NOT checked by this tool.)" % (f, what))
    rc, txt = run(["systemctl", "is-active", UNIT], 30)
    ok("%s.service is active" % UNIT) if (rc == 0 and txt.strip() == "active") else fail("%s.service is not active (%s)" % (UNIT, txt[:40]))
    rc, txt = run(["systemctl", "cat", UNIT], 30)
    if rc == 0 and re.search(r"--env-file\s+/etc/aicc/backend\.env(\s|$)", txt):
        ok("the unit starts the container with --env-file /etc/aicc/backend.env (a restart re-reads it)")
    else:
        fail("the unit does not read --env-file /etc/aicc/backend.env: a restart would not pick the new secret up")
    h, b = observe_lines(args.bystander)
    if not health_good(h):
        fail("the Backend /health is not ok (status ok, database connected, 40-hex build, entitlement_mode)")
    elif h["entitlement_mode"] != "enforced":
        fail("entitlement_mode is %s, expected enforced" % h["entitlement_mode"])
    else:
        ok("Backend health ok, build %s, entitlement_mode enforced" % h["build"][:12])
    if not b["healthy"]:
        fail("the bystander container %s is not healthy (state=%s health=%s): refusing to touch this host" % (b["name"], b["state"], b["health"]))
    else:
        ok("the bystander container %s is running (StartedAt %s)" % (b["name"], b["started_at"]))
    if args.id and not fails and baseline_values(args.id)[0] is None:
        take_lock()
        append_state(args.id, "baseline", baseline_build=h["build"], baseline_mode=h["entitlement_mode"], bystander_started_at=b["started_at"], bystander_state=b["state"])
        ok("baseline recorded in the journal (build, mode, bystander StartedAt)")
    say("PREFLIGHT %s" % ("FAILED (%d)" % len(fails) if fails else "OK"))
    return 1 if fails else 0


def do_stage(args):
    i = need_id(args)
    if sys.stdin.isatty():
        die("REFUSED: stdin is a terminal; the new secret arrives on a pipe (the owner script sends it over ssh)")
    data = sys.stdin.buffer.read(100)
    if len(data) > 70:
        die("REFUSED: more than 70 bytes on stdin (a secret is one line of 64 hex characters)")
    if data.endswith(b"\n"):
        data = data[:-1]
    if b"\n" in data or b"\r" in data or b"\0" in data:
        die("REFUSED: the input is not exactly one line")
    if not HEX64_RE.fullmatch(data) or not valid_secret(data):
        die("REFUSED: the input does not have the shape of the new secret (64 lowercase hex characters, at least 12 distinct; length %d)" % len(data))
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back; start a new rotation with a new id" % i)
    nf = fp(data)
    if lstat_or_none(staged_path(i)) is not None:
        if fp(read_staged(i)) == nf:
            say("already staged: id=%s fp=%s (nothing changed)" % (i, nf))
            return 0
        die("REFUSED: a DIFFERENT secret is already staged for id %s (a staged secret is immutable; use a new id)" % i)
    if any(e[0] == nf for e in registry_entries()):
        die("REFUSED: the new secret is a retired one")
    ensure_dir(ROTROOT)
    ensure_dir(os.path.join(ROTROOT, i))
    u, g = root_ids()
    atomic_write(staged_path(i), data, "api_stage", u, g, 0o600)
    append_state(i, "staged", staged_fp=nf)
    audit("stage", i, "staged", staged_fp=nf)
    say("staged: id=%s fp=%s file=/etc/aicc/webhook-rotation/%s/next.secret root 0600" % (i, nf, i))
    return 0


def fail_apply(i, why, args):
    say("APPLY FAILED: %s" % why)
    say("restoring the env file copy, restarting the Backend and waiting for health...")
    ok, msg = restore_env(i, args.health_timeout)
    if ok:
        append_state(i, "apply-failed", restored="yes", live_fp=msg, reason="see_output")
        audit("apply", i, "apply-failed-restored", old_fp=msg)
        say("APPLY FAILED AND RESTORED: the Backend runs the PREVIOUS secret again (fp %s), health ok with the same build. Nothing else changed. The Control Plane was not touched." % msg)
        return 1
    append_state(i, "apply-failed", restored="NO", reason="restore_failed")
    audit("apply", i, "apply-failed-RESTORE-FAILED")
    say("CRITICAL: THE AUTOMATIC RESTORE FAILED: %s" % msg)
    say("STATE UNKNOWN: the complete env copy is /etc/aicc/backend.env.pre-webhook-rotation-%s (cp -p it over /etc/aicc/backend.env, then `sudo systemctl restart %s`), then run `status --id %s`." % (i, UNIT, i))
    return 3


def do_apply(args):
    i = need_id(args)
    take_lock()
    take_env_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back; start a new rotation with a new id" % i)
    if lp == "finalized":
        say("already finalized: id=%s (nothing changed)" % i)
        return 0
    new = read_staged(i)
    nf = fp(new)
    pr = env_file_problems(ENVF)
    if pr:
        die("REFUSED: /etc/aicc/backend.env: %s" % ", ".join(pr))
    data = read_env()
    k, cur, pp = parse_env(data)
    if pp:
        die("REFUSED: /etc/aicc/backend.env: %s" % "; ".join(pp))
    cur_fp = fp(cur)
    rc, txt = run(["systemctl", "cat", UNIT], 30)
    if rc != 0 or not re.search(r"--env-file\s+/etc/aicc/backend\.env(\s|$)", txt):
        die("REFUSED: the %s unit does not read --env-file /etc/aicc/backend.env" % UNIT)
    bb, bm = baseline_values(i)
    h, note = get_health()
    if not health_good(h):
        die("REFUSED: the Backend /health is not ok before the change (%s): nothing was changed" % (note or "unexpected body"))
    if not bb:
        bb, bm = h["build"], h["entitlement_mode"]
        b0 = bystander(args.bystander)
        append_state(i, "baseline", baseline_build=bb, baseline_mode=bm, bystander_started_at=b0["started_at"], bystander_state=b0["state"])
    if h["build"] != bb or h["entitlement_mode"] != bm:
        die("REFUSED: the Backend build/mode changed since the baseline (build %s, mode %s): investigate before rotating" % (h["build"][:12], h["entitlement_mode"]))
    b = bystander(args.bystander)
    if not b["healthy"]:
        die("REFUSED: the bystander container %s is not healthy (state=%s health=%s): nothing was changed" % (b["name"], b["state"], b["health"]))
    resumed = cur_fp == nf
    if not resumed:
        if any(e[0] == nf for e in registry_entries()):
            die("REFUSED: the staged secret is a retired one")
        made = make_backup(i)
        if made is None:
            die("REFUSED: %s exists and holds a different secret than the current env: inconsistent, investigate (status --id %s)" % (os.path.basename(backup_path(i)), i))
        kill_at("api_after_backup")
        append_state(i, "apply-begin", old_fp=cur_fp, staged_fp=nf)
        lines = data.split(b"\n")
        lines[k] = ENV_KEY + new
        newdata = b"\n".join(lines)
        if mask(newdata, k) != mask(data, k) or newdata.count(b"\n") != data.count(b"\n") or newdata.split(b"\n")[k] != ENV_KEY + new:
            die("REFUSED: internal check: the new env file would differ from the old one in more than the one line (nothing written)")
        st = os.lstat(ENVF)
        atomic_write(ENVF, newdata, "api_env", st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), xattr_from=ENVF)
        st2 = os.lstat(ENVF)
        chk = read_env()
        if chk != newdata or stat.S_IMODE(st2.st_mode) != stat.S_IMODE(st.st_mode) or (st2.st_uid, st2.st_gid) != (st.st_uid, st.st_gid):
            return fail_apply(i, "the env file read back differs from what was written, or its mode/owner changed", args)
        if mask(chk, k) != mask(read_env(backup_path(i)), k):
            return fail_apply(i, "after masking the secret line the new env file differs from the copy", args)
    else:
        if lstat_or_none(backup_path(i)) is None:
            die("REFUSED: the env already holds the staged secret but there is no env copy %s: investigate (status --id %s)" % (os.path.basename(backup_path(i)), i))
        append_state(i, "apply-begin", old_fp=phase_value(i, "old_fp") or "unknown", staged_fp=nf, resumed="yes")
    kill_at("api_after_env")
    status, err = post_probe(new)
    if status == 400 and err == "webhook_payload_malformed":
        say("the running Backend already accepts the new secret: no restart needed")
    else:
        rc, txt = run(["systemctl", "restart", UNIT], 60)
        if rc != 0:
            return fail_apply(i, "`systemctl restart %s` failed (exit %d): %s" % (UNIT, rc, txt.splitlines()[-1] if txt else "no output"), args)
        kill_at("api_after_restart")
        ok, msg = wait_health(bb, bm, args.health_timeout)
        if not ok:
            return fail_apply(i, msg, args)
        status, err = post_probe(new)
        if status != 400 or err != "webhook_payload_malformed":
            return fail_apply(i, "the Backend does not accept the new secret after the restart (probe %s %s)" % (status, err), args)
    b2 = bystander(args.bystander)
    append_state(i, "applied", staged_fp=nf, old_fp=phase_value(i, "old_fp") or cur_fp, bystander_started_at=b2["started_at"])
    audit("apply", i, "applied", staged_fp=nf, old_fp=phase_value(i, "old_fp") or cur_fp)
    say("applied: id=%s the Backend runs the NEW secret (fp %s); health ok, build %s, mode %s unchanged; env file 640 root:aicc, only the one line changed; complete copy kept as /etc/aicc/backend.env.pre-webhook-rotation-%s" % (i, nf, bb[:12], bm, i))
    say("BYSTANDER name=%s state=%s health=%s started_at=%s" % (b2["name"], b2["state"], b2["health"], b2["started_at"]))
    return 0


def do_probe_new(args):
    if args.id:
        if env_value() != read_staged(args.id):
            say("probe-new: FAIL the env's secret is not the staged one of id %s" % args.id)
            return 1
    v = env_value()
    status, err = post_probe(v)
    if status == 400 and err == "webhook_payload_malformed":
        say("probe-new: PASS status=400 error=webhook_payload_malformed (the Backend accepts the env's secret, fp %s)" % fp(v))
        return 0
    say("probe-new: FAIL status=%s error=%s (expected 400 webhook_payload_malformed; the env's secret fp is %s)" % (status, err, fp(v)))
    return 1


def do_probe_old(args):
    i = need_id(args)
    if lstat_or_none(backup_path(i)) is None:
        die("REFUSED: no env copy for id %s" % i)
    v = env_value(backup_path(i))
    want = phase_value(i, "old_fp")
    if want and fp(v) != want:
        say("probe-old: FAIL the env copy's secret (fp %s) is not the one the journal recorded (fp %s): the probe would prove nothing" % (fp(v), want))
        return 1
    status, err = post_probe(v)
    if status == 401 and err == "webhook_signature_invalid":
        say("probe-old: PASS status=401 error=webhook_signature_invalid (the Backend rejects the previous secret, fp %s)" % fp(v))
        return 0
    if status == 400:
        say("probe-old: FAIL status=400: THE BACKEND STILL ACCEPTS THE PREVIOUS (EXPOSED) SECRET (fp %s)" % fp(v))
        return 1
    say("probe-old: FAIL status=%s error=%s (expected 401 webhook_signature_invalid)" % (status, err))
    return 1


def do_registry_check(args):
    i = need_id(args)
    old = phase_value(i, "old_fp")
    say("REGISTRY id=%s listed=%s old_fp_listed=%s" % (i, "yes" if any(e[2] == i for e in registry_entries()) else "no", "yes" if old and any(e[0] == old for e in registry_entries()) else "no"))
    return 0


def do_fingerprint(args):
    which = args.which or "env"
    if which == "env":
        say(fp(env_value()))
    elif which == "staged":
        say(fp(read_staged(need_id(args))))
    elif which == "backup":
        i = need_id(args)
        if lstat_or_none(backup_path(i)) is None:
            die("absent: env copy of id %s" % i)
        say(fp(env_value(backup_path(i))))
    else:
        die("REFUSED: --which must be env, staged or backup")
    return 0


def do_rollback(args):
    i = need_id(args)
    take_lock()
    take_env_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp is None:
        say("nothing to roll back on this host: no journal for id %s (this host was never staged or changed for it)" % i)
        return 0
    listed = any(e[2] == i for e in registry_entries())
    if (lp == "finalized" or listed) and not args.i_reinstate_a_retired_secret:
        die("REFUSED: id %s is FINALIZED or listed in the retired registry (a finalize was interrupted): its previous secret is RETIRED (it was exposed). Rolling back would put an exposed secret back. If you really must, a manual decision with --i-reinstate-a-retired-secret; `verify` will keep failing RETIRED_SECRET_IN_USE until a new rotation." % i)
    if lp == "rolled-back":
        say("already rolled back: id=%s (nothing changed)" % i)
        return 0
    bk = backup_path(i)
    if lstat_or_none(bk) is None:
        append_state(i, "rolled-back", env_changed="no")
        audit("rollback", i, "rolled-back")
        say("rolled back: id=%s never changed the env file (no env copy exists); the staged secret stays (never deleted)." % i)
        return 0
    old_val = env_value(bk)
    same = read_env() == read_env(bk)
    if not same and any(e[0] == fp(old_val) for e in registry_entries()) and not args.i_reinstate_a_retired_secret:
        die("REFUSED: rolling back would restore the secret with fingerprint %s, which is listed as RETIRED (this was a rotation that replaced a retired secret). Nothing was changed. If you really want the retired secret back: --i-reinstate-a-retired-secret." % fp(old_val))
    status, err = post_probe(old_val)
    if same and status == 400 and err == "webhook_payload_malformed":
        say("the previous env file is already in place and the Backend accepts the previous secret (nothing to restore)")
    else:
        ok, msg = restore_env(i, args.health_timeout)
        if not ok:
            append_state(i, "apply-failed", restored="NO", reason="rollback_restore_failed")
            say("CRITICAL: the rollback could not restore the Backend: %s" % msg)
            say("STATE UNKNOWN: cp -p /etc/aicc/backend.env.pre-webhook-rotation-%s /etc/aicc/backend.env, then `sudo systemctl restart %s`, then `status --id %s`." % (i, UNIT, i))
            return 3
    if lp == "finalized" or listed:
        append_state(i, "reinstated", live_fp=fp(old_val))
        audit("reinstate", i, "reinstated", old_fp=fp(old_val))
        say("WARNING: A RETIRED SECRET (fp %s) WAS REINSTATED ON THE BACKEND BY YOUR EXPLICIT DECISION. IT IS EXPOSED. `verify` WILL FAIL RETIRED_SECRET_IN_USE UNTIL A NEW ROTATION." % fp(old_val))
        return 0
    append_state(i, "rolled-back", live_fp=fp(old_val), env_changed="restored")
    audit("rollback", i, "rolled-back", old_fp=fp(old_val))
    say("ROLLED BACK ON THE BACKEND: THE PREVIOUS SECRET (fp %s) -- THE EXPOSED ONE -- IS BACK IN SERVICE. THE ROTATION MUST BE RE-RUN." % fp(old_val))
    return 0


def do_finalize(args):
    i = need_id(args)
    take_lock()
    sweep_temps()
    lp = last_phase(i)
    if lp is None:
        die("REFUSED: no rotation with id %s" % i)
    if lp == "rolled-back":
        die("REFUSED: id %s was rolled back" % i)
    if lp not in ("applied", "finalized"):
        die("REFUSED: id %s is in phase %s, not applied (finalize only after a successful apply)" % (i, lp))
    new = read_staged(i)
    if lstat_or_none(backup_path(i)) is None:
        die("CRITICAL: the env copy of %s is missing" % i, 3)
    if env_value() != new:
        die("REFUSED: the env's secret is not the staged one")
    old_fp = fp(env_value(backup_path(i)))
    h, note = get_health()
    if not health_good(h):
        die("REFUSED: the Backend /health is not ok (%s)" % (note or "unexpected body"))
    status, err = post_probe(new)
    if status != 400 or err != "webhook_payload_malformed":
        die("REFUSED: the Backend does not accept the staged secret (probe %s %s)" % (status, err))
    if args.dry_run:
        say("finalize dry-run: id=%s every precondition holds (applied, env is the staged secret, Backend healthy and accepting it, env copy present); NOTHING was written" % i)
        return 0
    if lp != "finalized":
        # the journal line FIRST: from here on a rollback is refused on the journal AND on the registry, so there is no window in which the registry lists the secret while the journal still allows a rollback
        append_state(i, "finalized", retired_fp=old_fp, live_fp=fp(new))
        audit("finalize", i, "finalized", old_fp=old_fp, staged_fp=fp(new))
    added = registry_add(old_fp, i)
    kill_at("api_after_registry")
    say("finalized: id=%s previous secret fp=%s is RETIRED (registry %s); the env copy /etc/aicc/backend.env.pre-webhook-rotation-%s is KEPT (never deleted)." % (i, old_fp, "updated" if added else "already had it", i))
    return 0


MODES = {"status": do_status, "preflight": do_preflight, "stage": do_stage, "apply": do_apply, "probe-new": do_probe_new, "probe-old": do_probe_old, "fingerprint": do_fingerprint,
         "rollback": do_rollback, "finalize": do_finalize, "registry-check": do_registry_check}


def main():
    ap = argparse.ArgumentParser(prog=NAME, allow_abbrev=False, description="see the header of this file")
    ap.add_argument("mode", choices=sorted(MODES))
    ap.add_argument("--id")
    ap.add_argument("--expect-hostname", dest="expect_hostname")
    ap.add_argument("--which")
    ap.add_argument("--bystander", default=BYSTANDER_DEFAULT)
    ap.add_argument("--health-timeout", type=int, default=90, dest="health_timeout")
    ap.add_argument("--i-reinstate-a-retired-secret", action="store_true", dest="i_reinstate_a_retired_secret")
    ap.add_argument("--replace-retired-secret", action="store_true", dest="replace_retired_secret")
    ap.add_argument("--dry-run", action="store_true", dest="dry_run")
    args = ap.parse_args()
    if args.id is not None and not ID_RE.fullmatch(args.id):
        die("REFUSED: --id must look like 20261117T182030Z (UTC time of the rotation)", 2)
    if not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{0,62}", args.bystander):
        die("REFUSED: --bystander is not a plain container name", 2)
    if not 1 <= args.health_timeout <= 600:
        die("REFUSED: --health-timeout must be 1..600 seconds", 2)
    if not HARNESS and os.geteuid() != 0:
        die("must run as root (sudo). Refusing.")
    check_host(args, args.mode in ("preflight", "stage", "apply", "rollback", "finalize"))
    return MODES[args.mode](args)


try:
    sys.exit(main())
except SystemExit:
    raise
except BaseException as e:
    sys.stderr.write("%s: internal error (%s)\n" % (NAME, type(e).__name__))
    sys.exit(1)
