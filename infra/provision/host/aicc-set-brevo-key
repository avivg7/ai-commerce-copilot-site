#!/usr/bin/env bash
# aicc-set-brevo-key: places, rotates, revokes and inspects the Brevo API key FILE of the production Control Plane. Runs ON THE HOST, as root (sudo), normally started over SSH by the owner's
# infra/provision/set-brevo-key.sh on the Mac, which sends the key on this script's STDIN (never in a command line, an environment variable, a file or a log).
#
#     sudo aicc-set-brevo-key install [--expect-stage-id <32 hex>]   key on STDIN (one line); refuses when the file already exists (use rotate)
#     sudo aicc-set-brevo-key rotate  [--expect-stage-id <32 hex>]   key on STDIN; requires the file to exist; the previous key is NOT kept: revoke it in Brevo
#     sudo aicc-set-brevo-key revoke  [--expect-stage-id <32 hex>]   removes the file (nothing else is changed); the key must ALSO be revoked in Brevo
#     sudo aicc-set-brevo-key status                                  stat + shape check of the file, never its content
#
# THE FILE: /etc/aicc-mail/brevo-api.key, root:aicc-cp 0640, a regular file (never a symlink), in the 0750 root:aicc-cp directory that already holds smtp.env / turnstile.secret (PHP can traverse it; /etc/aicc it
#   cannot). Content = the key, one line plus the newline. The Control Plane constant AICC_MAIL_API_KEY_FILE holds only this PATH (rendered by render-wp-config.sh when the owner fact AICC_MAIL_PROVIDER=brevo_api is set).
# WHAT IT DOES AND DOES NOT DO: reads at most 257 bytes from stdin; validates the shape ([A-Za-z0-9_-]{20,200}, one line; a Brevo SMTP key `xsmtpsib-...` is refused: an API key is needed); writes a temp file in the same
#   directory (O_EXCL, umask 0277, mode 0400 until it is complete), sets root:aicc-cp 0640, fsyncs it, renames it over the target atomically (a crash leaves the old key or nothing, never a partial key; a stale temp file is removed
#   by the next run) and fsyncs the directory. It touches no other file (smtp.env and turnstile.secret are never opened for writing), keeps NO copy of the previous key and does not render or reload anything.
# OUTPUT: only `installed: <path> root:aicc-cp 640 <size>` and the first 8 hex characters of the key's SHA-256 (a rotation fingerprint). One audit line (time, operator, action, fingerprint prefix) goes to the system
#   journal: `logger -t aicc-brevo-key`. The key is never printed, echoed, logged or put in an argument, and is not stored in a shell variable (the whole path is inside one python3 -I process reading stdin).
# TEST SEAMS (honoured ONLY with AICC_TEST_HARNESS=1, and then ONLY when AICC_ROOT_PREFIX names a directory under the system temp dir; a loud TEST HARNESS ACTIVE banner goes to stderr): AICC_ROOT_PREFIX re-roots the absolute paths; AICC_TEST_OWNER=user:group replaces root:aicc-cp; AICC_TEST_KILL_AT=<stage> makes the process kill -9 itself at a stage
#   (after_create, after_write, after_fsync, after_rename) to prove atomicity.
set -euo pipefail
die() { printf 'aicc-set-brevo-key: %s\n' "$*" >&2; exit 1; }
# the key must never appear in a trace: refuse to run traced at all (checked FIRST; the key is not in this shell anyway: it goes straight from stdin into one python3 -I process)
case "$-" in *x*) die "REFUSED: shell tracing (set -x) is on; the key could be traced" ;; esac
[ -z "${BASH_XTRACEFD:-}" ] || die "REFUSED: BASH_XTRACEFD is set; the key could be traced"
case ":${SHELLOPTS:-}:" in *:xtrace:*) die "REFUSED: SHELLOPTS contains xtrace" ;; esac
umask 0077       # the python writer sets umask 0277 itself before it creates the temp file
HARNESS=0; PREFIX=""
# under_tmp <dir>: is the real path of an existing directory below the system temp dir ($TMPDIR, /tmp, /var/tmp, macOS /private/var/folders)?
under_tmp() {
  local d t; [ -d "$1" ] || return 1; d="$(cd "$1" && pwd -P)"
  for t in "${TMPDIR:-}" /tmp /var/tmp; do [ -n "$t" ] || continue; t="$(cd "$t" 2>/dev/null && pwd -P)" || continue; case "$d/" in "$t"/*) return 0 ;; esac; done
  case "$d/" in /private/var/folders/*) return 0 ;; esac
  return 1
}
if [ "${AICC_TEST_HARNESS:-0}" = "1" ]; then
  # the test seams can re-root every path and fake the owner: they are refused unless the prefix is a scratch directory, and they are never silent
  PREFIX="${AICC_ROOT_PREFIX:-}"; PREFIX="${PREFIX%/}"
  [ -n "$PREFIX" ] && under_tmp "$PREFIX" || die "REFUSED: AICC_TEST_HARNESS=1 needs AICC_ROOT_PREFIX to be an existing directory under the system temp dir (the seams are for tests only)"
  HARNESS=1
  printf 'aicc-set-brevo-key: *** TEST HARNESS ACTIVE: paths re-rooted under %s, owner/kill/short-write seams honoured. Never set this on a real host. ***\n' "$PREFIX" >&2
fi
MODE="${1:-}"; [ -n "$MODE" ] && shift || { sed -n 2,9p "${BASH_SOURCE[0]}" >&2; exit 2; }
case "$MODE" in install|rotate|revoke|status) ;; -h|--help) sed -n 2,9p "${BASH_SOURCE[0]}"; exit 0 ;; *) die "unknown mode '$MODE' (install, rotate, revoke, status)" ;; esac
EXPECT_ID=""
while [ $# -gt 0 ]; do
  case "$1" in
    --expect-stage-id) EXPECT_ID="${2:-}"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done
if [ "$HARNESS" != 1 ] && [ "$(id -u)" != "0" ]; then die "must run as root (sudo). Refusing."; fi
MAILDIR="$PREFIX/etc/aicc-mail"; IDENT="$PREFIX/etc/aicc-stage-identity"; LOGICAL_FILE="/etc/aicc-mail/brevo-api.key"
OWNER_WANT="root:aicc-cp"; [ "$HARNESS" != 1 ] || OWNER_WANT="${AICC_TEST_OWNER:-root:aicc-cp}"
# host identity: when the caller names the stage id, it must be THIS machine (production, www.copilt.org). Checked before the key is read.
if [ -n "$EXPECT_ID" ] || [ "$MODE" != status ]; then
  [ -r "$IDENT" ] || die "REFUSED: no host identity ($IDENT)"
  grep -q '^AICC_ENV=production$' "$IDENT" || die "REFUSED: this host's identity does not say AICC_ENV=production"
  grep -q '^AICC_HOSTNAME=www\.copilt\.org$' "$IDENT" || die "REFUSED: this host's identity is not www.copilt.org"
  if [ -n "$EXPECT_ID" ]; then
    [[ "$EXPECT_ID" =~ ^[0-9a-f]{32}$ ]] || die "REFUSED: --expect-stage-id must be 32 hex characters"
    grep -q "^AICC_STAGE_ID=${EXPECT_ID}\$" "$IDENT" || die "REFUSED: the host's stage id differs from --expect-stage-id (wrong machine?)"
  fi
fi

read -r -d '' PYSRC <<'PYEOF' || true
import grp, hashlib, os, re, signal, stat, sys

mode, maildir, logical, owner_want, harness, expect_kill, short_write = sys.argv[1:8]
NAME = "brevo-api.key"
target = os.path.join(maildir, NAME)
SHAPE = re.compile(rb"[A-Za-z0-9_-]{20,200}")
TEMP_PREFIX = ".brevo-api.key.new."


def die(msg, code=1):
    sys.stderr.write("aicc-set-brevo-key: %s\n" % msg)
    sys.exit(code)


def want_ids():
    u, g = owner_want.split(":", 1)
    if harness == "1":
        import pwd
        return pwd.getpwnam(u).pw_uid, grp.getgrnam(g).gr_gid
    return 0, grp.getgrnam(g).gr_gid


def kill_at(stage):
    if harness == "1" and expect_kill == stage:
        os.kill(os.getpid(), signal.SIGKILL)


def check_dir():
    try:
        st = os.lstat(maildir)
    except OSError:
        die("REFUSED: %s does not exist (it is created by install-stack.sh: root:aicc-cp 0750)" % os.path.dirname(logical))
    if not stat.S_ISDIR(st.st_mode):
        die("REFUSED: %s is not a directory (a symbolic link is refused)" % os.path.dirname(logical))
    uid, gid = want_ids()
    if st.st_uid != uid or st.st_gid != gid or stat.S_IMODE(st.st_mode) != 0o750:
        die("REFUSED: %s must be %s 0750 (is uid %d gid %d mode %04o)" % (os.path.dirname(logical), owner_want, st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)))


def target_state():
    """None (absent) or the lstat of a REGULAR file; a symlink or anything else is refused."""
    try:
        st = os.lstat(target)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(st.st_mode):
        die("REFUSED: %s is not a regular file (a symbolic link, directory or special file is never replaced)" % logical)
    return st


def stale_temps():
    out = []
    for n in os.listdir(maildir):
        if n.startswith(TEMP_PREFIX):
            p = os.path.join(maildir, n)
            if stat.S_ISREG(os.lstat(p).st_mode):
                out.append(p)
    return out


def lock_dir():
    """Non-blocking exclusive flock on the key directory for install / rotate / revoke: two concurrent runs can never interleave. Held until the process exits."""
    import fcntl
    fd = os.open(maildir, os.O_RDONLY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("REFUSED: another aicc-set-brevo-key is running (the key directory is locked); wait for it, run `status`, then retry")
    return fd


def fsync_dir():
    fd = os.open(maildir, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def describe(st):
    uid, gid = want_ids()
    own = owner_want if (st.st_uid == uid and st.st_gid == gid) else "uid%d:gid%d" % (st.st_uid, st.st_gid)
    return own, "%o" % stat.S_IMODE(st.st_mode)


def shape_of_file():
    """First line of the existing file against the shape; returns 'ok' or a reason. The content is never returned or printed."""
    try:
        with open(target, "rb") as f:
            raw = f.read(300)
    except OSError:
        return "unreadable"
    first = raw.split(b"\n", 1)[0].rstrip(b"\r")
    if not SHAPE.fullmatch(first):
        return "BAD SHAPE (not [A-Za-z0-9_-]{20,200} on the first line)"
    if first.startswith(b"xsmtpsib-"):
        return "WRONG KIND (an SMTP key, an API key is needed)"
    return "ok"


def do_status():
    check_dir_ok = True
    try:
        check_dir()
    except SystemExit:
        check_dir_ok = False
    st = None
    try:
        st = os.lstat(target)
    except FileNotFoundError:
        pass
    if st is None:
        print("absent: %s" % logical)
    elif not stat.S_ISREG(st.st_mode):
        print("PRESENT BUT NOT A REGULAR FILE: %s (symbolic link or special file)" % logical)
    else:
        own, mo = describe(st)
        verdict = "mode/owner ok" if (own == owner_want and mo in ("640", "440")) else "MODE/OWNER NOT ACCEPTED (renderer wants %s 640 or 440)" % owner_want
        print("present: %s %s %s %d bytes; %s; shape: %s" % (logical, own, mo, st.st_size, verdict, shape_of_file()))
    if not check_dir_ok:
        print("directory check FAILED (see above)")
    n = stale_temps() if os.path.isdir(maildir) else []
    if n:
        print("stale temp file(s): %d (removed by the next install/rotate/revoke)" % len(n))
    return 0


def read_key():
    if sys.stdin.isatty():
        die("REFUSED: stdin is a terminal; the key must arrive on a pipe (the owner script sends it over ssh)")
    data = sys.stdin.buffer.read(258)
    if len(data) > 257:
        die("REFUSED: more than 257 bytes on stdin (a key is one line of 20-200 characters)")
    if data.endswith(b"\n"):
        data = data[:-1]
    if b"\n" in data or b"\r" in data or b"\0" in data:
        die("REFUSED: the input is not exactly one line")
    if data.startswith(b"xsmtpsib-"):
        die("REFUSED: this is an SMTP key (xsmtpsib-...), an API key is needed (Brevo: SMTP & API -> API Keys)")
    if not SHAPE.fullmatch(data):
        die("REFUSED: the input does not have the shape of a Brevo API key ([A-Za-z0-9_-]{20,200}; length %d)" % len(data))
    return data


def do_write(key):
    uid, gid = want_ids()
    os.umask(0o277)
    data = key + b"\n"
    tmp = os.path.join(maildir, "%s%d" % (TEMP_PREFIX, os.getpid()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    try:
        kill_at("after_create")
        chunk = data[:-3] if (harness == "1" and short_write == "1") else data    # the seam only SIMULATES a short write()
        n = os.write(fd, chunk)
        # a short write must NEVER replace a good key: the byte count and the real size of the temp file are both checked before anything is committed
        if n != len(data) or os.fstat(fd).st_size != len(data):
            die("REFUSED: the key was not written completely (wrote %d of %d bytes); the existing key file was NOT touched" % (n, len(data)))
        kill_at("after_write")
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o640)
        os.fsync(fd)
        kill_at("after_fsync")
    except BaseException:
        os.close(fd)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.close(fd)
    os.replace(tmp, target)
    fp = hashlib.sha256(key).hexdigest()[:8]
    sys.stderr.write("FP=%s\n" % fp)      # the audit line is written even if a later check fails: the rename HAS happened
    kill_at("after_rename")
    fsync_dir()
    st = os.lstat(target)
    own, mo = describe(st)
    if not (stat.S_ISREG(st.st_mode) and own == owner_want and mo == "640" and st.st_size == len(key) + 1):
        die("the key file WAS replaced but does not have the expected owner, mode or size (%s %s %d): STATE UNKNOWN, run `status` and investigate before rendering" % (own, mo, st.st_size))
    print("installed: %s %s 640 %d" % (logical, own, st.st_size))
    print("fingerprint: sha256:%s (first 8 hex of the key's SHA-256: a rotation fingerprint, not the key)" % fp)


def main():
    if mode == "status":
        return do_status()
    check_dir()
    lock_fd = lock_dir()   # noqa: F841 (kept open on purpose)
    cur = target_state()
    for p in stale_temps():
        os.unlink(p)
    if mode == "revoke":
        if cur is None:
            print("nothing to revoke: %s is absent" % logical)
            sys.stderr.write("FP=none\n")
            return 0
        os.unlink(target)
        fsync_dir()
        print("revoked: %s removed (no other file touched)" % logical)
        sys.stderr.write("FP=none\n")
        return 0
    if mode == "install" and cur is not None:
        die("REFUSED: %s already exists; to replace the key use `rotate` (and revoke the old key in Brevo)" % logical)
    if mode == "rotate" and cur is None:
        die("REFUSED: %s does not exist; nothing to rotate, use `install`" % logical)
    key = read_key()
    do_write(key)
    return 0


try:
    sys.exit(main())
except SystemExit:
    raise
except BaseException as e:   # never a traceback with local state: only the class of the problem
    sys.stderr.write("aicc-set-brevo-key: internal error (%s)\n" % type(e).__name__)
    sys.exit(1)
PYEOF

# the python process's stderr carries one machine line "FP=<8 hex>|none" for the audit log; everything else is passed through
KILL_AT=""; SHORT_WRITE=""; [ "$HARNESS" != 1 ] || { KILL_AT="${AICC_TEST_KILL_AT:-}"; SHORT_WRITE="${AICC_TEST_SHORT_WRITE:-}"; }
errf="$(mktemp "${TMPDIR:-/tmp}/aicc-brevo-err.XXXXXX")"; trap 'rm -f "$errf"' EXIT
rc=0
python3 -I -c "$PYSRC" "$MODE" "$MAILDIR" "$LOGICAL_FILE" "$OWNER_WANT" "$HARNESS" "$KILL_AT" "$SHORT_WRITE" 2>"$errf" || rc=$?
grep -v '^FP=' "$errf" >&2 || true
fp="$(sed -En 's/^FP=([0-9a-f]{8}|none)$/\1/p' "$errf" | head -1)"
if [ "$MODE" != status ]; then
  operator="${SUDO_USER:-$(id -un)}"
  # one audit line per CHANGE: also when a later check failed after the rename (result=committed-then-failed), because the file did change
  if [ "$rc" = 0 ]; then result=ok; elif [ -n "$fp" ]; then result=committed-then-failed; else result=""; fi
  if [ -n "$result" ]; then logger -t aicc-brevo-key -- "action=$MODE operator=$operator fingerprint_prefix=${fp:-none} result=$result path=$LOGICAL_FILE" 2>/dev/null || true; fi
fi
if [ "$rc" = 0 ] && [ "$MODE" != status ]; then
  case "$MODE" in
    install) echo "NEXT: owner facts + render + reload (docs/cutover/p38-brevo-host-update.md section 6). Keep the key in Brevo only as long as it is the current one." ;;
    rotate) echo "REMINDER: the previous key is GONE from this host (no copy is kept) but is STILL VALID in Brevo until you revoke it: REVOKE IT IN BREVO NOW (SMTP & API -> API Keys), then check with: sudo aicc-wp aicc-mail check" ;;
    revoke) echo "REMINDER: the file is removed. The key itself is still valid until you REVOKE it in Brevo (SMTP & API -> API Keys). To turn mail off on the site: sudo aicc-owner-facts unset AICC_MAIL_PROVIDER, render, reload." ;;
  esac
fi
exit "$rc"
