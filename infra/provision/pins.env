# Pinned versions and published checksums for the AICC staging/production stack. KEY=VALUE only, no secrets, sourced by bash.
# Changing a pin is a reviewed commit: update the version AND the checksum together, then re-run infra:test.
#
# Provenance of each checksum (be honest about the trust chain):
#  CADDY_*   : sha512 of caddy_2.11.7_linux_amd64.tar.gz from the release's caddy_2.11.7_checksums.txt, as downloaded by the owner into
#              ~/aicc-rehearsal/checksums.txt. Consistency check done: the sha512 of the macOS tarball next to it (also from that release)
#              equals its line in that file. The Sigstore signature of the checksums file is verified on the HOST when `cosign` exists
#              (install-stack.sh --require-cosign makes it mandatory) or by the owner on the Mac (see RUNBOOK-stage-bringup.md step 4).
#  WPCLI_*   : sha256 equals the value Homebrew's wp-cli 2.12.0 formula pins for the official release phar; sha512 computed from that
#              same phar file. The host additionally downloads the release's published .sha512 and requires it to equal this pin.
CADDY_VERSION=2.11.7
CADDY_ARCH=linux_amd64
CADDY_TARBALL=caddy_2.11.7_linux_amd64.tar.gz
CADDY_TARBALL_SHA512=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7
CADDY_RELEASE_BASE=https://github.com/caddyserver/caddy/releases/download/v2.11.7
CADDY_CHECKSUMS_FILE=caddy_2.11.7_checksums.txt
# Sigstore keyless identity of Caddy's release workflow (documented by the Caddy project; confirm on the host with cosign before relying on it)
CADDY_COSIGN_IDENTITY_REGEXP='^https://github\.com/caddyserver/caddy/\.github/workflows/'
CADDY_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com

WPCLI_VERSION=2.12.0
WPCLI_URL=https://github.com/wp-cli/wp-cli/releases/download/v2.12.0/wp-cli-2.12.0.phar
WPCLI_SHA512_URL=https://github.com/wp-cli/wp-cli/releases/download/v2.12.0/wp-cli-2.12.0.phar.sha512
WPCLI_SHA256=ce34ddd838f7351d6759068d09793f26755463b4a4610a5a5c0a97b68220d85c
WPCLI_SHA512=be928f6b8ca1e8dfb9d2f4b75a13aa4aee0896f8a9a0a1c45cd5d2c98605e6172e6d014dda2e27f88c98befc16c040cbb2bd1bfa121510ea5cdf5f6a30fe8832

# Distro packages (versions come from Ubuntu 24.04 + unattended security updates; only the series is pinned)
PHP_SERIES=8.3
MYSQL_SERIES=8.0
