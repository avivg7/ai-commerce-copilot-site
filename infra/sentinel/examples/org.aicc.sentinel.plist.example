<?xml version="1.0" encoding="UTF-8"?>
<!-- EXAMPLE ONLY, not installed. Mac option: runs one sentinel round every 60 s while the Mac is awake.
     Copy to ~/Library/LaunchAgents/org.aicc.sentinel.plist, edit the paths, then: launchctl load ~/Library/LaunchAgents/org.aicc.sentinel.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.aicc.sentinel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3.12</string>
    <string>/Users/YOU/aicc-sentinel/sentinel.py</string>
    <string>--config</string><string>/Users/YOU/aicc-sentinel/targets.toml</string>
    <string>--state</string><string>/Users/YOU/aicc-sentinel/state.json</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/Users/YOU/aicc-sentinel/sentinel.err.log</string>
  <key>StandardOutPath</key><string>/Users/YOU/aicc-sentinel/sentinel.out.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
