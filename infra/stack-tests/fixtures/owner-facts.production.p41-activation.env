# SYNTHETIC fixture: the live facts (owner-facts.production.live.env) PLUS the owner's P41 activation facts (docs/cutover/p41-activation-runbook.md). The Turnstile site key is a PLACEHOLDER of the right shape,
# not a real key. Every value below is non-secret; the Turnstile SECRET and the Brevo key are FILES the renderer only checks.
AICC_OWNER_METRICS_TOKEN_FILE=/srv/aicc/shared/owner-metrics.token
AICC_OWNER_METRICS_BASE=https://api.copilt.org
AICC_OWNER_DASHBOARD_USER_IDS=1
AICC_EA_LAUNCH_OFFER_MODE=announce
AICC_OWNER_OPS_SNAPSHOT_FILE=/srv/aicc/shared/owner-ops-snapshot.json
AICC_MAIL_PROVIDER=brevo_api
AICC_MAIL_FROM_ADDRESS=notifications@copilt.org
AICC_MAIL_FROM_NAME=AI Commerce Copilot
AICC_MAIL_REPLY_TO=support@copilt.org
AICC_MAIL_DAILY_BUDGET=240
AICC_TURNSTILE_ENABLED=true
AICC_TURNSTILE_SITE_KEY=0x4AAAAAAApubLICsitekey01
AICC_NOTIFY_EXCLUDED_CUSTOMERS=2
AICC_NOTIFY_ENABLED=true
AICC_OWNER_OPS_SECTION_ENABLED=true
AICC_FUNNEL_COUNTERS_ENABLED=true
AICC_MILESTONE_SYNC_SCHEDULED=true
AICC_TRIAL_SELF_SERVICE_CAP=25
AICC_TRIAL_SELF_SERVICE_ENABLED=true
AICC_LEGAL_REVIEW_APPROVED=true
