[Unit]
Description=Hourly AICC backup (database dump, files archive, restore smoke)

[Timer]
# Hourly at minute 17 UTC: the staging database is a few MB, a full run (dump + gzip test + restore smoke + archive) takes ~10 s at the lowest CPU/IO priority.
# This bounds the on-host RPO to ~1 h; the off-host copy is as fresh as the owner's Mac last pulled (see README-backup.md). Retention: 7 days, never fewer than 3 sets.
OnCalendar=*-*-* *:17:00 UTC
# up to 2 minutes of jitter is harmless and keeps the unit from starting in the same second as other jobs
RandomizedDelaySec=120
AccuracySec=1s
# a missed run (host was down) executes shortly after boot
Persistent=true
Unit=aicc-backup.service

[Install]
WantedBy=timers.target
