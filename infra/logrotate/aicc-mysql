# /etc/logrotate.d/aicc-mysql  -  the slow log (error log is handled by Ubuntu's own mysql-server logrotate file).
# MySQL reopens its log files on FLUSH LOGS; the postrotate uses the local socket as root (auth_socket), so no password is involved.
/var/log/mysql/slow.log {
    weekly
    maxsize 20M
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    create 0640 mysql adm
    su mysql adm
    postrotate
        test -S /run/mysqld/mysqld.sock && /usr/bin/mysqladmin --protocol=socket --socket=/run/mysqld/mysqld.sock flush-logs slow >/dev/null 2>&1 || true
    endscript
}
