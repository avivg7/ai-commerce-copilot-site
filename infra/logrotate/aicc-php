# /etc/logrotate.d/aicc-php  -  PHP-FPM pool logs (error, slow, CLI) and the staging mail sink are written by aicc-cp.
# weekly + size trigger: small host, small logs; 8 weeks kept; copytruncate because php-fpm keeps the files open (no reload needed).
/var/log/aicc-cp/*.log {
    weekly
    maxsize 50M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 aicc-cp adm
    su aicc-cp adm
}
