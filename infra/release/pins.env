# Pinned upstream sources for the Control Plane release (WordPress core + WooCommerce). KEY=VALUE only, no secrets.
# These are the versions the rehearsal fixture (~/aicc-rehearsal/cp) runs: WordPress 7.1.3 (wp-includes/version.php), WooCommerce 10.9.4.
# Trust chain, stated honestly:
#   WordPress core : wordpress.org publishes a SHA-1 next to the tarball (https://wordpress.org/wordpress-7.1.3.tar.gz.sha1, matched when pinned). The SHA-256 below
#                    was computed by us from that verified download; from now on THE PIN IS THE TRUST ANCHOR (any other bytes are refused).
#   WooCommerce    : downloads.wordpress.org serves the plugin zip over TLS; there is no separate published checksum. The SHA-256 below was computed from
#                    that download TWICE (a cached copy in ~/.wp-cli/cache from 2026-10-18 and a fresh download on 2026-10-21: identical).
# To change a version: download, verify as above, update BOTH the version and the hash in one reviewed commit, rebuild.
WP_VERSION=7.1.3
WP_TARBALL_URL=https://wordpress.org/wordpress-7.1.3.tar.gz
WP_TARBALL_SHA1=491a78c7676b15dffcc69130c6054b8f49228a91
WP_TARBALL_SHA256=d2a09acb6a15e3b9c471d72557753c266d6f41a79ed19bfe04cbfe49e283b2a5
WC_VERSION=10.9.4
WC_ZIP_URL=https://downloads.wordpress.org/plugin/woocommerce.10.9.4.zip
WC_ZIP_SHA256=6e58fc3ba9b18d1c9aee6b0227d3c3c09e4fe2c1332823bd2e0ac54ffcff64a9
# Storefront is the PARENT theme of the AICC theme (style.css: Template: storefront). Without it WordPress treats aicc-admin as broken, so it is part of every release.
# Same version the rehearsal fixture runs (4.6.2). SHA-256 computed from a fresh download and equal to the copy in ~/.wp-cli/cache/theme (the fixture's source).
STOREFRONT_VERSION=4.6.2
STOREFRONT_ZIP_URL=https://downloads.wordpress.org/theme/storefront.4.6.2.zip
STOREFRONT_ZIP_SHA256=163b5bf217dad76a823432d8c01598ab3dc3f15cbdd69067b98f5a6ddf05c1c4
