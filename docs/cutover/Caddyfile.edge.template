# ---------------------------------------------------------------------------------------------------------------------------------
# Apex and plain-http hosts: everything not already redirected above goes to the same path and query on https://www.copilt.org
# ---------------------------------------------------------------------------------------------------------------------------------
http://copilt.org, https://copilt.org, http://www.copilt.org {
	import aicc_site_hook
	import aicc_tls
	import edge_log
	import security_headers
	import hsts
	import aicc_redirects
	# BEGIN GENERATED: host redirect
	@safe_method method GET HEAD
	redir @safe_method https://www.copilt.org{uri} 301
	redir https://www.copilt.org{uri} 308
	# END GENERATED: host redirect
}

# ---------------------------------------------------------------------------------------------------------------------------------
# Any other Host on port 80: no redirect (see auto_https disable_redirects above), no site, no content.
# ---------------------------------------------------------------------------------------------------------------------------------
http:// {
	import aicc_site_hook
	import edge_log
	import security_headers
	respond "Misdirected request" 421
}

# ---------------------------------------------------------------------------------------------------------------------------------
# The canonical host
# ---------------------------------------------------------------------------------------------------------------------------------
www.copilt.org {
	import aicc_site_hook
	import aicc_tls
	# REAL-CADDY FINDING: with the default minimum_length (512) a chunked WordPress response whose first write is small was never compressed (php -S; PHP-FPM + nginx may behave
	# differently). minimum_length 1 compresses it. Only compressible content types are encoded (mp4/jpg/woff2 are not).
	encode {
		zstd
		gzip
		minimum_length 1
	}
	import edge_log
	import security_headers
	import hsts
	import aicc_redirects

	# WordPress admin surface (OWNER DECISION 2026-10-20, implemented in the GENERATED routing below and proven by a real run, docs/cutover/rehearsal.md "wp-admin"):
	#   /xmlrpc.php          denied for everyone (403, any case/encoding/path-info form). No dependency exists in the Control Plane, plugin, theme or Backend (searched).
	#   /wp-admin/*          operators only (AICC_OPERATOR_CIDRS), EXCEPT /wp-admin/admin-ajax.php and /wp-admin/admin-post.php, which stay public (WordPress core, Action Scheduler's
	#                        async runner and any future payment-gateway plugin use them for visitors; WordPress does its own capability/nonce checks).
	#   /wp-login.php        operators only, EXCEPT the logout flow (?action=logout, ?loggedout=true): the plugin's Connect page and plan-intent code use wp_logout_url(),
	#                        which is /wp-login.php?action=logout for CUSTOMERS. Customer sign-in, registration and password reset are /my-account/ (WooCommerce), not wp-login.php.
	#   /wp-cron.php         operators only (DISABLE_WP_CRON is true and a system cron runs `wp cron event run --due-now`).
	#   dot-segments (/../, /./), backslashes and control characters in the path: 400 before anything is proxied (otherwise /pricing/../wp-admin/ would pass a rule that only looks at the prefix).

	# BEGIN GENERATED: routing
	@bad_path vars_regexp bad_path {http.request.uri.path} (?:^|/)\.{1,2}(?:/|$)|\\|[\x00-\x1f\x7f]
	handle @bad_path {
		header Cache-Control "no-store"
		respond "Bad request" 400
	}
	@bad_method method TRACE TRACK CONNECT
	handle @bad_method {
		header Cache-Control "no-store"
		respond "Method not allowed" 405
	}
	@xmlrpc_deny path_regexp xmlrpc_deny (?i)^/xmlrpc\.php(?:/.*)?$
	handle @xmlrpc_deny {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
	@wp_cron_deny {
		path_regexp wp_cron_deny (?i)^/wp-cron\.php(?:/.*)?$
		not remote_ip {$AICC_OPERATOR_CIDRS}
	}
	handle @wp_cron_deny {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
	@wp_admin_deny {
		path_regexp wp_admin_deny (?i)^/wp-admin(?:/|$)
		not path_regexp wp_admin_public (?i)^/wp-admin/(?:admin-ajax|admin-post)\.php$
		not remote_ip {$AICC_OPERATOR_CIDRS}
	}
	handle @wp_admin_deny {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
	@wp_login_deny {
		path_regexp wp_login_deny (?i)^/wp-login\.php(?:/.*)?$
		not expression {http.request.uri.query}.matches('(?i)(^|&)(action=logout|loggedout=true)(&|$)')
		not remote_ip {$AICC_OPERATOR_CIDRS}
	}
	handle @wp_login_deny {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
	@dup_error path_regexp dup_error ^/(?:404|_not-found)(?:/|\.html)?$
	handle @dup_error {
		error 404
	}
	@static_immutable path_regexp static_immutable ^/_next/static/.*$
	handle @static_immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		import to_static
	}
	@static_demo path_regexp static_demo ^/demo/.*$
	handle @static_demo {
		header Cache-Control "public, max-age=0, must-revalidate"
		import static_csp
		import to_static
	}
	@static_assets path_regexp static_assets ^(?:/(?:_next|brand-kit|fonts|og|demo)/.*|/(?:favicon\.ico|robots\.txt|sitemap\.xml|index\.txt)|/__next[^/]*\.txt)$
	handle @static_assets {
		header Cache-Control "public, max-age=86400"
		import static_csp
		import to_static
	}
	@wp_machine path_regexp wp_machine ^/(?:wp-json|wp-admin|wc-api|wc-ajax)(?:/.*)?$|^/(?:wp-login\.php|wp-cron\.php|xmlrpc\.php|wp-activate\.php|wp-signup\.php)$
	handle @wp_machine {
		import to_wordpress_nocache
	}
	@wp_assets path_regexp wp_assets ^/(?:wp-content|wp-includes)(?:/.*)?$
	handle @wp_assets {
		import to_wordpress
	}
	@wp_root_query {
		path_regexp wp_root ^(/(?:he|es|ru))?/$
		expression {http.request.uri.query}.matches('(^|&)(wc-ajax|wc-api|rest_route)=')
	}
	handle @wp_root_query {
		import to_wordpress_nocache
	}
	@rsc_under_wp path_regexp rsc_under_wp ^(/(?:he|es|ru))?/(?:pricing|privacy|terms|refund-policy|accessibility)/(?:__next[^/]*|index)\.txt$
	handle @rsc_under_wp {
		error 404
	}
	@static_rsc path_regexp static_rsc ^(/(?:he|es|ru))?(?:/(?:product|questions|data-and-trust))?/(?:__next[^/]*|index)\.txt$
	handle @static_rsc {
		header Cache-Control "public, max-age=0, must-revalidate"
		import to_static
	}
	@wp_nocache path_regexp wp_nocache ^(/(?:he|es|ru))?/(?:cart|checkout|my-account)(?:/.*)?$|^/wp-(?:json|admin|login\.php)(?:/.*)?$|^/wc-(?:ajax|api)(?:/.*)?$
	handle @wp_nocache {
		import to_wordpress_nocache
	}
	@wp_pages path_regexp wp_pages ^(/(?:he|es|ru))?/(?:pricing|privacy|terms|refund-policy|data-processing-addendum|accessibility|cart|checkout|my-account|product-category|shop)(?:/.*)?$|^(/(?:he|es|ru))?/product/.+$
	handle @wp_pages {
		import to_wordpress
	}
	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		import static_csp
		import to_static
	}
	# END GENERATED: routing

	# Branded 404 and 5xx for the edge (file not found, `error 404`, the duplicate-error-page paths). WordPress paths are proxied, so WordPress
	# renders its own 404 and its status and body pass through untouched. The status stays 404 (a soft 404 would be indexed).
	handle_errors {
		# REAL-CADDY FINDING: a response produced here does NOT inherit the site block's `header` directives, so without these two imports every branded 404/5xx page
		# went out without HSTS, nosniff, X-Request-Id etc. and with `Server: Caddy`.
		import security_headers
		import hsts
		# 5xx (WordPress down, upstream timeout, an upstream 5xx converted by wp_proxy): the standalone branded page from the static root instead of Caddy's empty body (owner direction:
		# "AI Commerce Copilot is temporarily unavailable. Please try again shortly."; inline CSS, no external request, no script; `npm run test:error-page` checks it). Copy docs/cutover/50x.html
		# into every release directory. It carries no secrets and no upstream detail and does not say which part is affected. The status stays 502/503/504 (never 200). Never cached.
		@servererror expression {http.error.status_code} >= 500
		handle @servererror {
			root * {$AICC_STATIC_ROOT}
			rewrite * /50x.html
			header Cache-Control "no-store"
			header Retry-After "30"
			header -Server
			file_server {
				status {http.error.status_code}
			}
		}
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * {$AICC_STATIC_ROOT}
			rewrite * /404.html
			header Cache-Control "no-store"
			file_server {
				status {http.error.status_code}
			}
		}
	}
}

