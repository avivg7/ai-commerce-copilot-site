# Branded 404 and 5xx for the edge, imported by the canonical site block AND the operator listener block (same pages, same headers).
(aicc_error_pages) {
	# Branded 404 and 5xx for the edge (file not found, `error 404`, the duplicate-error-page paths). WordPress paths are proxied, so WordPress
	# renders its own 404 and its status and body pass through untouched. The status stays 404 (a soft 404 would be indexed).
	handle_errors {
		# REAL-CADDY FINDING: a response produced here does NOT inherit the site block's `header` directives, so without these two imports every branded 404/5xx page
		# went out without HSTS, nosniff, X-Request-Id etc. and with `Server: Caddy`.
		import security_headers
		import hsts
		# 5xx (WordPress down, upstream timeout, an upstream 5xx converted by wp_proxy): the standalone branded page from the static root instead of Caddy's empty body (owner direction:
		# "AI Commerce Copilot is temporarily unavailable. Please try again shortly."; inline CSS, no external request, no script; `npm run test:error-page` checks it). Copy docs/cutover/50x.html
		# into every release directory. It carries no secrets and no upstream detail and does not say which part is affected. The status stays 502/503/504 (never 200). Never cached.
		@servererror expression {http.error.status_code} >= 500
		handle @servererror {
			root * {$AICC_STATIC_ROOT}
			rewrite * /50x.html
			header Cache-Control "no-store"
			header Retry-After "30"
			header -Server
			file_server {
				status {http.error.status_code}
			}
		}
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * {$AICC_STATIC_ROOT}
			rewrite * /404.html
			header Cache-Control "no-store"
			file_server {
				status {http.error.status_code}
			}
		}
	}
}

# ---------------------------------------------------------------------------------------------------------------------------------
# Apex and plain-http hosts: everything not already redirected above goes to the same path and query on https://www.copilt.org
# The body lives in a snippet because it is used by TWO blocks: the http:// addresses (no TLS directive allowed there) and https://copilt.org (which imports aicc_tls).
# ---------------------------------------------------------------------------------------------------------------------------------
(apex_site) {
	import edge_log public
	import security_headers
	import hsts
	import aicc_redirects
	# BEGIN GENERATED: host redirect
	@safe_method method GET HEAD
	redir @safe_method https://www.copilt.org{uri} 301
	redir https://www.copilt.org{uri} 308
	# END GENERATED: host redirect
}

http://copilt.org, http://www.copilt.org {
	import aicc_site_hook
	import apex_site
}

# BEGIN APEX-HTTPS (production topology only; the stage render has no apex)
https://copilt.org {
	import aicc_site_hook
	import aicc_tls
	import apex_site
}
# END APEX-HTTPS

# ---------------------------------------------------------------------------------------------------------------------------------
# Any other Host on port 80: no redirect (see auto_https disable_redirects above), no site, no content.
# ---------------------------------------------------------------------------------------------------------------------------------
http:// {
	import aicc_site_hook
	import edge_log public
	import security_headers
	respond "Misdirected request" 421
}

# ---------------------------------------------------------------------------------------------------------------------------------
# The canonical host (PUBLIC listener)
# ---------------------------------------------------------------------------------------------------------------------------------
www.copilt.org {
	import aicc_site_hook
	import aicc_tls
	# REAL-CADDY FINDING: with the default minimum_length (512) a chunked WordPress response whose first write is small was never compressed (php -S; PHP-FPM + nginx may behave
	# differently). minimum_length 1 compresses it. Only compressible content types are encoded (mp4/jpg/woff2 are not).
	encode {
		zstd
		gzip
		minimum_length 1
	}
	import edge_log public
	import security_headers
	import hsts
	import aicc_redirects
	import aicc_health
	import aicc_stage_identity

	# WordPress admin surface (OWNER DECISIONS 2026-10-20 and 2026-10-21, implemented in the GENERATED routing below and proven by a real run, docs/cutover/rehearsal.md "wp-admin"):
	#   /xmlrpc.php          denied for everyone, on both listeners (403, any case/encoding/path-info form). No dependency exists in the Control Plane, plugin, theme or Backend (searched).
	#   /wp-admin/*          the OPERATOR LISTENER only (below), EXCEPT /wp-admin/admin-ajax.php and /wp-admin/admin-post.php, which stay public (WordPress core, Action Scheduler's
	#                        async runner and any future payment-gateway plugin use them for visitors; WordPress does its own capability/nonce checks).
	#   /wp-login.php        the operator listener only, EXCEPT the GET-only logout shapes (?action=logout, ?loggedout=true): the plugin's Connect page and plan-intent code use
	#                        wp_logout_url(), which is /wp-login.php?action=logout for CUSTOMERS. Customer sign-in, registration and password reset are /my-account/ (WooCommerce).
	#   /wp-cron.php         the operator listener only (DISABLE_WP_CRON is true and a system cron runs `wp cron event run --due-now`).
	#   PHP files            only WordPress's entry points are ever handed to PHP-FPM (php_direct); dotfiles, logs, dumps and readme/license files of WordPress's trees are 404 (wp_hidden).
	#   dot-segments (/../, /./), backslashes and control characters in the path: 400 before anything is proxied (otherwise /pricing/../wp-admin/ would pass a rule that only looks at the prefix).
	# The optional AICC_OPERATOR_CIDRS list (empty by default) is an extra way to be an operator on THIS listener; stage/production never set it.

	# BEGIN GENERATED: routing
	@bad_path vars_regexp bad_path {http.request.uri.path} (?:^|/)\.{1,2}(?:/|$)|\\|[\x00-\x1f\x7f]
	handle @bad_path {
		header Cache-Control "no-store"
		respond "Bad request" 400
	}
	@bad_method method TRACE TRACK CONNECT
	handle @bad_method {
		header Cache-Control "no-store"
		respond "Method not allowed" 405
	}
	@xmlrpc_deny path_regexp xmlrpc_deny (?i)^/xmlrpc\.php(?:/.*)?$
	handle @xmlrpc_deny {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
