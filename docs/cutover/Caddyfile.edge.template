# =====================================================================================================================================
# NOT APPLIED. TEMPLATE. Nothing here is installed, validated by a real Caddy, or live. Review, then `caddy validate` and rehearse on staging.
# =====================================================================================================================================
#
# AICC public edge for the www-canonical model (owner decision 2026-10-19):
#   https://www.copilt.org/       the ONLY customer-visible host. One origin per path: static site (Next export) or WordPress (Control Plane).
#   https://copilt.org/*          301 to https://www.copilt.org/* (path and query kept; one hop; 308 for non-GET so a POST keeps its method).
#   http://*                      same, straight to https://www (no http -> https -> www chain).
#   https://api.copilt.org        NOT in this file. It stays its own Caddy site block on the API host (139.59.157.231) and is never proxied here.
#
# Why Caddy (recommendation): the API host already runs Caddy, so it is the one edge tool the operator already runs; it issues and renews the
# certificates for BOTH copilt.org and www.copilt.org (the apex needs a valid cert or its https redirect fails before it can redirect); its
# config is short enough to review line by line; reverse_proxy passes Host, Cookie and Set-Cookie untouched. nginx would also satisfy
# docs/unified-experience/domain-migration.md (A11.4); the rules are edge-agnostic, see docs/cutover/redirect-matrix.md.
# Where it runs (the API droplet, a separate small host, or in front of the WordPress host) is an owner/ops decision. Do not share a Caddyfile
# or a process with the API if you want the API's trust boundary and TRUST_PROXY_HEADERS assumption (Caddy is its only proxy) left untouched.
#
# SOURCE OF TRUTH for the redirect/routing blocks: scripts/lib/redirect-matrix.mjs. The blocks between BEGIN GENERATED / END GENERATED are
# written by `node scripts/test-redirects.mjs --write` and checked by `npm run test:redirects`. Do not edit them by hand.
#
# What was reviewed and what was not: this file has NEVER been parsed by a real Caddy (none is installed here). `npm run test:redirects` checks the generated blocks
# and a MODEL of this file (site blocks, imports, matcher order); it cannot see a syntax or semantics error. `caddy validate` plus a `curl --resolve` replay of the
# same cases on staging is a hard gate (docs/cutover/runbook.md section 1).
#
# Environment (set in the systemd unit, not in this file):
#   AICC_STATIC_ROOT   directory holding the static export, built with  AICC_BASE_PATH="" SITE_URL=https://www.copilt.org npm run build  (the out/ folder)
#   (the static root must also contain 50x.html: copy docs/cutover/50x.html into every release directory, see the runbook's release procedure)
#   AICC_WP_UPSTREAM   WordPress origin, e.g. 10.0.0.12:8080 (plain http on a private network) or https://wp.internal.example (then add `transport http { tls }`)
#
# WordPress prerequisites (otherwise cookies, redirects and absolute URLs break; see docs/cutover/redirect-matrix.md "Hidden dependencies"):
#   * options `home` and `siteurl` = https://www.copilt.org  (set BEFORE the first customer; WordPress cookie names embed a hash of siteurl)
#   * wp-config.php:  if ( ( $_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '' ) === 'https' ) { $_SERVER['HTTPS'] = 'on'; }   (the plugin sets Secure cookies from is_ssl())
#   * no COOKIE_DOMAIN: cookies stay host-only on www.copilt.org (never share them with api.copilt.org)
#   * real client address: the edge OVERWRITES X-Forwarded-For with the address Caddy saw (header_up below; a client-supplied value is never passed through, and
#     do NOT add `trusted_proxies` to the public edge). WordPress must believe that header only from the edge: wp-config.php  define( 'AICC_LM_TRUSTED_PROXIES', array( '<edge private ip>' ) );
#     (class AICC_LM_Client_IP in the license-manager plugin; empty = REMOTE_ADDR as before). Without it every per-IP rate limit (REST 30/min, Connect AICC) is one global limit.
#   * WP-Cron: DISABLE_WP_CRON true plus a system cron `* * * * * wp cron event run --due-now` (the entitlement outbox delivery and the daily expiry sweep run on WP-Cron).
#   * TLS: pre-issue certificates for www.copilt.org and copilt.org BEFORE the DNS flip (DNS-01, or `tls /path/cert.pem /path/key.pem` from a CA you control), or start this
#     file only after DNS moves and reload immediately. For every rehearsal use `tls internal` or the ACME staging CA (acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
#     in the global options block). Ports 80/443 (TCP, and UDP 443 for HTTP/3) must be reachable over IPv4 and IPv6. See runbook section 3.
#   * .well-known: only ACME is handled by Caddy itself. Search Console HTML verification, security.txt and a future Apple Pay domain-association file must ship in the
#     static site (public/.well-known/, then rebuild) or get an explicit route here.
#   * X-Frame-Options SAMEORIGIN is set on everything below. A hosted-iframe payment flow can render OUR order-received page inside the gateway's frame: when a gateway is chosen,
#     drop X-Frame-Options (and use a per-gateway CSP frame-ancestors) for /checkout/* only. Not needed while no gateway is configured.

# ---------------------------------------------------------------------------------------------------------------------------------
# Snippets
# ---------------------------------------------------------------------------------------------------------------------------------
# Access log. Contains no cookies, no Authorization header and no Set-Cookie; query parameters that carry tokens are redacted (add the Connect AICC / license parameter
# names the plugin really uses). UNVERIFIED syntax: check with `caddy validate`. Rotate with logrotate or `roll_size`.
(edge_log) {
	log {
		output file /var/log/caddy/aicc-edge.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri query {
					replace token REDACTED
					replace key REDACTED
					replace license_key REDACTED
				}
			}
		}
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# HSTS ramp: start at 300 seconds, raise to 86400, then 31536000 only after the staging pass and a clean week.
# No includeSubDomains and no preload on purpose: api.copilt.org and any staging host manage their own TLS policy, and a preload entry cannot be undone quickly.
(hsts) {
	header Strict-Transport-Security "max-age=300"
}

# Static pages only. Report-Only first: the Next export inlines scripts (self.__next_f.push) so 'unsafe-inline' is needed until nonces/hashes exist.
# WordPress paths get NO CSP here: WooCommerce inlines scripts and the payment provider's origins are not known yet (undecided gateway).
(static_csp) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
}

# WordPress upstream. Caddy keeps the original Host and sets X-Forwarded-For/-Proto/-Host; Cookie and Set-Cookie pass through unchanged.
(to_wordpress) {
	reverse_proxy {$AICC_WP_UPSTREAM} {
		# Overwrite, never append: WordPress trusts this header only from this edge (AICC_LM_TRUSTED_PROXIES). Caddy already replaces client-supplied X-Forwarded-* when
		# `trusted_proxies` is not configured; stating it here keeps that true if someone adds a global option later.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# transport http { tls }   # uncomment when the upstream is https
	}
}

# Commerce, account and machine paths (cart, checkout, my-account, wp-json, wp-admin, wp-login, wc-ajax, wc-api, wp-cron): the edge forces "never cache" even if WordPress
# forgets (WooCommerce already sends nocache headers). /wp-content/ and /wp-includes/ are deliberately NOT here: they use to_wordpress, so WordPress / the hosting stack decide.
(to_wordpress_nocache) {
	reverse_proxy {$AICC_WP_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_down Cache-Control "private, no-store, max-age=0"
		# transport http { tls }
	}
}

(to_static) {
	root * {$AICC_STATIC_ROOT}
	file_server
}

