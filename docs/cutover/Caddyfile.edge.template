	}
	@wp_root_query {
		path_regexp wp_root ^(/(?:he|es|ru))?/$
		expression {http.request.uri.query}.matches('(^|&)(wc-ajax|wc-api|rest_route)=')
	}
	handle @wp_root_query {
		import to_wordpress_nocache
	}
