# Snippets
# ---------------------------------------------------------------------------------------------------------------------------------
# Per-site TLS. Empty in production = automatic ACME. Replaced by `tls internal` in the rehearsal. To use certificates you pre-issued (runbook 1.10 i), write here:
#   tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
(aicc_tls) {
	# production: automatic HTTPS
}

# Hook for rehearsal-only rules (the generator fills it with a "loopback peers only" guard because the rehearsal binds the wildcard address; production leaves it empty).
(aicc_site_hook) {
}

# Access log. JSON, rotated (20 MiB x 5 kept, 30 days: a hard cap of about 100 MiB), and REDACTED: no Cookie / Set-Cookie / Authorization values, and no secret-bearing query
# parameter in any logged URI (WooCommerce password-reset links carry ?key=...&id=..., order links ?key=wc_order_..., the Connect flow ?token=...). The Referer and Location
# headers are filtered the same way because a page opened from a reset link sends it as the Referer of every sub-request. Also logged: the real peer address
# (request.remote_ip), status, duration, a per-request id (the same X-Request-Id sent upstream and back to the client) and the upstream that answered (empty = served by Caddy itself).
# Verified by a real run: docs/cutover/rehearsal.md "Logging".
(edge_log) {
	log {
		output file {$AICC_LOG_DIR:/var/log/caddy}/aicc-edge.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Wp-Nonce delete
				request>headers>X-Api-Key delete
				request>headers>Referer regexp "(?i)([?&](?:key|login|user_login|pass|password|pwd|pass1|pass2|token|code|nonce|_wpnonce|reset|license_key|license|secret|auth|signature|sig)=)[^&#]*" "${1}REDACTED"
				resp_headers>Set-Cookie delete
				resp_headers>Location regexp "(?i)([?&](?:key|login|user_login|pass|password|pwd|pass1|pass2|token|code|nonce|_wpnonce|reset|license_key|license|secret|auth|signature|sig)=)[^&#]*" "${1}REDACTED"
				request>uri regexp "(?i)([?&](?:key|login|user_login|pass|password|pwd|pass1|pass2|token|code|nonce|_wpnonce|reset|license_key|license|secret|auth|signature|sig)=)[^&#]*" "${1}REDACTED"
			}
		}
	}
	log_append request_id {http.request.uuid}
	log_append upstream {http.reverse_proxy.upstream.hostport}
}

# Every response, whichever handler produced it (`defer`: applied after the upstream answered, so a header WordPress also sends is REPLACED, never duplicated).
(security_headers) {
	header {
		defer
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Request-Id {http.request.uuid}
		-Server
		-X-Powered-By
		-Via
	}
	# The edge decides the request id; a client-supplied one is overwritten and the upstream receives this one.
	request_header X-Request-Id {http.request.uuid}
}

# HSTS ramp: start at 300 seconds, raise to 86400, then 31536000 only after the staging pass and a clean week.
# No includeSubDomains and no preload on purpose: api.copilt.org and any staging host manage their own TLS policy, and a preload entry cannot be undone quickly.
(hsts) {
	header {
		defer
		Strict-Transport-Security "max-age=300"
	}
}

# Static pages only. Report-Only first: the Next export inlines scripts (self.__next_f.push) so 'unsafe-inline' is needed until nonces/hashes exist.
# WordPress paths get NO CSP here: WooCommerce inlines scripts and the payment provider's origins are not known yet (undecided gateway).
(static_csp) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
}

# The one place that talks to WordPress. The edge OVERWRITES what the client may have sent about itself (X-Forwarded-For / -Proto / -Host are set from the connection;
# Forwarded, X-Real-IP and friends are removed), so WordPress sees only edge-made values: it trusts X-Forwarded-For solely from the edge (AICC_LM_TRUSTED_PROXIES).
# An upstream 5xx (PHP fatal, WordPress critical error page) is NOT shown to the visitor: it becomes the edge's own 5xx page with the same status (handle_errors below).
# Upstream leaks (X-Powered-By, Server) are removed. Do NOT add `trusted_proxies` to the public edge.
(wp_proxy) {
	reverse_proxy {$AICC_WP_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -X-Client-IP
		header_up -True-Client-IP
		header_up -X-Forwarded-Server
		header_up -X-Original-URL
		header_up -X-Rewrite-URL
		# More client-identity / scheme headers that code on the origin may read as if they were trusted (WooCommerce's Store API rate limiter reads Client-IP;
		# phase-2 browser rehearsal showed a page-script-supplied value of each of these reached WordPress unchanged). Edge-made values only.
		header_up -Client-IP
		header_up -CF-Connecting-IP
		header_up -X-Cluster-Client-IP
		header_up -X-Originating-IP
		header_up -Fastly-Client-IP
		header_up -Forwarded-For
		header_up -X-Forwarded
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Scheme
		header_up -X-Forwarded-Ssl
		header_up -Front-End-Https
		header_up -X-Url-Scheme
		header_down -X-Powered-By
		header_down -Server
		transport http {
			dial_timeout 3s
			response_header_timeout {$AICC_WP_TIMEOUT:60s}
			# tls   # uncomment when the upstream is https
		}
		# REAL-CADDY FINDING: `error {rp.status_code}` does not take the placeholder (every upstream 5xx became a 500), so one handle_response per status keeps 502/503/504 as they are.
		@up500 status 500
		handle_response @up500 {
			error 500
		}
		@up501 status 501
		handle_response @up501 {
			error 501
		}
		@up502 status 502
		handle_response @up502 {
			error 502
		}
		@up503 status 503
		handle_response @up503 {
			error 503
		}
		@up504 status 504
		handle_response @up504 {
			error 504
		}
	}
}

# WordPress upstream for pages and WordPress's own static files: Cache-Control is whatever WordPress sends (it sends no-store/private for personalised pages and validators for files).
(to_wordpress) {
	import wp_proxy
}

# Commerce, account and machine paths (cart, checkout, my-account, wp-json, wp-admin, wp-login, wc-ajax, wc-api, wp-cron): the edge forces "never cache" even if WordPress
# forgets (WooCommerce already sends nocache headers). /wp-content/ and /wp-includes/ are deliberately NOT here: they use to_wordpress, so WordPress / the hosting stack decide.
(to_wordpress_nocache) {
	header {
		defer
		Cache-Control "private, no-store, max-age=0"
	}
	import wp_proxy
}

(to_static) {
	root * {$AICC_STATIC_ROOT}
	file_server
}

