# ---------------------------------------------------------------------------------------------------------------------------------
# The canonical host
# ---------------------------------------------------------------------------------------------------------------------------------
www.copilt.org {
	encode zstd gzip
	import edge_log
	import security_headers
	import hsts
	import aicc_redirects

	# [OWNER] decision, OFF in v1: restrict the WordPress admin and block XML-RPC. Uncomment ONE or both after the owner names the admin IPs / SSO.
	# Keep /wp-admin/admin-ajax.php open: front-end code calls it. xmlrpc.php is unused by the plugin and the theme (verify with the Backend/plugin owners first).
	# @xmlrpc path /xmlrpc.php
	# respond @xmlrpc 403
	# @wp_admin_locked {
	#	path /wp-admin/* /wp-login.php
	#	not path /wp-admin/admin-ajax.php
	#	not remote_ip {$AICC_ADMIN_IPS}
	# }
	# respond @wp_admin_locked 403

	# BEGIN GENERATED: routing
	@dup_error path_regexp dup_error ^/(?:404|_not-found)(?:/|\.html)?$
	handle @dup_error {
		error 404
	}
	@static_immutable path_regexp static_immutable ^/_next/static/.*$
	handle @static_immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		import to_static
	}
	@static_assets path_regexp static_assets ^(?:/(?:_next|brand-kit|fonts|og|demo)/.*|/(?:favicon\.ico|robots\.txt|sitemap\.xml|index\.txt)|/__next[^/]*\.txt)$
	handle @static_assets {
		header Cache-Control "public, max-age=86400"
		import static_csp
		import to_static
	}
	@wp_machine path_regexp wp_machine ^/(?:wp-json|wp-admin|wc-api|wc-ajax)(?:/.*)?$|^/(?:wp-login\.php|wp-cron\.php|xmlrpc\.php|wp-activate\.php|wp-signup\.php)$
	handle @wp_machine {
