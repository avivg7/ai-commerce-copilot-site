	}
	@wp_pages path_regexp wp_pages ^(/(?:he|es|ru))?/(?:pricing|privacy|terms|refund-policy|data-processing-addendum|accessibility|cart|checkout|my-account|product-category|shop)(?:/.*)?$|^(/(?:he|es|ru))?/product/.+$
	handle @wp_pages {
		import to_wordpress
	}
	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		import static_csp
		import to_static
	}
	# END GENERATED: routing

	# Branded 404 and 5xx for the edge (file not found, `error 404`, the duplicate-error-page paths). WordPress paths are proxied, so WordPress
	# renders its own 404 and its status and body pass through untouched. The status stays 404 (a soft 404 would be indexed).
	handle_errors {
		# 5xx (WordPress down, upstream timeout): a plain page from the static root instead of Caddy's empty body. Copy docs/cutover/50x.html into every release directory.
		# It carries no secrets and no upstream detail. Status codes pass through (502/503/504 stay what they are).
		@servererror expression {http.error.status_code} >= 500
		handle @servererror {
			root * {$AICC_STATIC_ROOT}
			rewrite * /50x.html
			header Cache-Control "no-store"
			file_server {
				status {http.error.status_code}
			}
		}
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * {$AICC_STATIC_ROOT}
			rewrite * /404.html
			header Cache-Control "no-store"
			file_server {
				status {http.error.status_code}
			}
		}
	}
