    "test:target-guard": "node scripts/test-target-guard.mjs",
    "test:account-url": "node scripts/test-account-url.mjs",
    "rehearsal": "node scripts/rehearsal/rehearsal.mjs",
    "staging:replay": "node scripts/staging-replay.mjs",
    "infra:lint": "bash infra/stack-tests/lint.sh",
    "infra:test": "bash infra/stack-tests/run-all.sh",
    "rehearsal:browser": "node scripts/rehearsal/browser-flows.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "test:payment-gate": "node scripts/test-payment-gate.mjs",
    "test:error-page": "node scripts/test-error-page.mjs",
