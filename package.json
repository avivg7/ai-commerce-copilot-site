    "brand:sync": "node scripts/sync-brand-kit.mjs",
    "test:brand-sync": "node scripts/test-sync-brand-kit.mjs",
    "brand:publish": "node scripts/publish-brand-assets.mjs",
    "prebuild": "node scripts/publish-brand-assets.mjs",
    "predev": "node scripts/publish-brand-assets.mjs",
    "test:visual-contract": "node scripts/visual-contract.mjs",
    "test:visual-contract:site": "node scripts/visual-contract.mjs --surfaces=site",
