    "shots:aa": "node scripts/shots-aa.mjs",
    "shots:content": "node scripts/shots-content.mjs",
    "ops:test": "cd infra/aicc-ops && python3.12 -W error::ResourceWarning -m unittest discover -s tests -t . -v",
