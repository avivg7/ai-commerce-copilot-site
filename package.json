    "content:check": "node scripts/content-check.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "contrast:pixels": "node scripts/pixel-contrast.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "audit": "node scripts/audit.mjs",
    "axe:check": "node scripts/axe-pages.mjs",
    "fallback:check": "node scripts/fallback-check.mjs",
    "lang:check": "node scripts/lang-scope-check.mjs",
