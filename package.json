  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jiti": "^2.7.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
